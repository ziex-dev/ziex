const zx = @import("zx");
const std = @import("std");
const options = @import("build_options");
const data = @import("data.zig");
const store = @import("components_data.zig");
const routes_store = @import("routes/store.zig");
const tree = @import("tree.zig");
const format = @import("format.zig");
const connection = @import("connection.zig");
const ConnectionFallback = @import("connection_fallback.zx");
const icons = @import("./components/icons.zx");

const Component = data.Component;
const StateItem = data.StateItem;
const is_browser_mode = options.platform == .development;

pub fn ComponentSearchInput(ctx: *zx.ComponentCtx(struct {})) zx.Component {
    return (
        <div @allocator={ctx.allocator} class="search-input-wrapper">
            {icons.Search(ctx.allocator)}
            <input
                @allocator={ctx.allocator}
                oninput={handleComponentSearchInput}
                type="text"
                placeholder="Search elements…"
                class="search-input"
            />
        </div>
    );
}

/// Route path selector for standalone browser DevTools (not Chrome/Firefox panels).
pub fn RoutePathSelector(ctx: *zx.ComponentCtx(struct {})) ?zx.Component {
    if (comptime !is_browser_mode) return null;
    if (comptime zx.platform.isServer()) return null;

    routes_store.ensureFetched(ctx.allocator);
    _ = data.loadSettings();
    const current = data.current_path;

    return (
        <select
            @allocator={ctx.allocator}
            class="route-path-select"
            onchange={handleRoutePathChange}
            title="Inspect components for route"
            aria-label="Select route to inspect"
        >
            {for (routes_store.routes) |route| (
                if (route.has_page) (
                    <option
                        value={route.path}
                        selected={std.mem.eql(u8, route.path, current)}
                    >{route.path}</option>
                ) else ""
            )}
        </select>
    );
}

pub fn handleRoutePathChange(ctx: zx.client.Event) void {
    if (ctx.value()) |val| {
        data.setPath(val);
        store.invalidate();
        store.ensureFetched(zx.allocator);
        zx.client.rerender();
    }
}

pub fn ComponentTree(ctx: *zx.ComponentCtx(struct {})) ?zx.Component {
    if (comptime zx.platform.isServer()) return null;

    store.ensureFetched(ctx.allocator);
    _ = data.loadSettings();

    if (connection.isUnavailable()) {
        return ConnectionFallback.Fallback(ctx.allocator);
    }

    const sel = store.selected_component;
    const display_components = tree.filterNativeElements(ctx.allocator, store.components);
    return (
        <div @allocator={ctx.allocator} class="component-tree">
            <div class="component-list">
                {for (display_components) |comp| (
                    <ComponentItem
                        allocator={ctx.allocator}
                        id={comp.id}
                        name={comp.name}
                        has_children={comp.has_children}
                        children={comp.children}
                        depth={0}
                        selected={std.mem.eql(u8, comp.id, sel)}
                        badges={comp.badges}
                        is_native={comp.is_native}
                        selector={comp.selector}
                        occurrence={comp.occurrence}
                    />
                )}
            </div>
        </div>
    );
}

pub fn ComponentState(ctx: *zx.ComponentCtx(struct {})) ?zx.Component {
    if (comptime zx.platform.isServer()) return null;

    store.ensureFetched(ctx.allocator);
    const maybe_component = tree.findComponentById(store.components, store.selected_component);

    if (maybe_component) |comp| {
        const open_btn = if (comp.source.len > 0) (
            <button
                @allocator={ctx.allocator}
                class="prefs-chip"
                data-open-file={comp.source}
                data-open-line={ctx.allocator.print("{d}", .{comp.line}) catch "1"}
            >Open</button>
        ) else (
            <span @allocator={ctx.allocator}></span>
        );
        const client_badge = BuiltinBadges(ctx.allocator, comp.badges);
        if (comp.meta) |metadata| {
            return (
                <div @allocator={ctx.allocator} class="component-state-wrapper">
                    <div class="state-inspector-header">
                        <span class="state-title">{comp.name}</span>
                        {client_badge}
                        {open_btn}
                    </div>
                    <div @allocator={ctx.allocator} class="state-content">
                        <StateSection allocator={ctx.allocator} title="props" items={metadata.prop_items} />
                        <StateSection allocator={ctx.allocator} title="states" items={metadata.signal_items} />
                        <StateSection allocator={ctx.allocator} title="actions" items={metadata.action_items} />
                    </div>
                </div>
            );
        }
        return (
            <div @allocator={ctx.allocator} class="component-state-wrapper">
                <div class="state-inspector-header">
                    <span class="state-title">{comp.name}</span>
                    {client_badge}
                    {open_btn}
                </div>
                <div class="state-content"></div>
            </div>
        );
    }

    return (
        <div @allocator={ctx.allocator} class="component-state-wrapper">
            <div class="state-content"></div>
        </div>
    );
}

pub fn handleComponentSearchInput(ctx: zx.client.Event) void {
    store.setSearch(ctx.value());
    zx.client.rerender();
}

pub fn handleStateFilterInput(ctx: zx.client.Event) void {
    store.setStateFilter(ctx.value());
    zx.client.rerender();
}

pub fn ComponentStateFilter(ctx: *zx.ComponentCtx(struct {})) zx.Component {
    return (
        <div @allocator={ctx.allocator} class="filter-wrapper">
            <input
                @allocator={ctx.allocator}
                oninput={handleStateFilterInput}
                type="text"
                placeholder="Filter props…"
                class="filter-input"
            />
        </div>
    );
}

pub fn handleComponentClick(ctx: zx.client.Event) void {
    store.setSelected(ctx.value());
    zx.client.rerender();
}

pub fn NativeToggle(ctx: *zx.ComponentCtx(struct {})) zx.Component {
    const collapsed = data.tree_collapsed;
    const btn_class = if (collapsed) "native-toggle-btn native-toggle-btn-off" else "native-toggle-btn native-toggle-btn-on";
    return (
        <button
            @allocator={ctx.allocator}
            onclick={handleToggleNative}
            class={btn_class}
            title={if (collapsed) "Expand all" else "Collapse all"}
            aria-pressed={if (collapsed) "false" else "true"}
        >
            {icons.Code(ctx.allocator)}
        </button>
    );
}

pub fn handleToggleNative(_: zx.client.Event) void {
    store.toggleTreeCollapsed();
    zx.client.rerender();
}

pub fn Page(ctx: zx.PageContext) zx.Component {
    return (
        <div @allocator={ctx.arena} class="devtools-container">
            <div class="tree-pane">
                <div class="search-box">
                    <div class="search-wrapper">
                        <ComponentSearchInput @client />
                        <NativeToggle @client />
                        <button
                            id="zx-devtool-pick-btn"
                            class="native-toggle-btn picker-btn"
                            title="Select an element in the page to inspect"
                            aria-label="Pick an element in the page"
                            aria-pressed="false"
                        >
                            {icons.Inspect(ctx.arena)}
                        </button>
                        <RoutePathSelector @client />
                    </div>
                </div>
                <ComponentTree @client />
            </div>

            <div class="devtools-resize-handle"></div>

            <div class="state-panel">
                <div class="state-header">
                    <ComponentStateFilter @client />
                </div>
                <ComponentState @client />
            </div>
        </div>
    );
}

const ComponentItemProps = struct {
    id: []const u8,
    name: []const u8,
    has_children: bool,
    children: []const Component,
    depth: usize = 0,
    selected: bool = false,
    badges: []const []const u8 = &.{},
    is_native: bool = false,
    selector: []const u8 = "",
    occurrence: usize = 0,
};

fn BuiltinBadges(allocator: zx.Allocator, badges: []const []const u8) zx.Component {
    if (badges.len == 0) {
        return (
            <span @allocator={allocator}></span>
        );
    }
    var zx_ctx = zx.x.allocInit(allocator, .{});
    const children = allocator.alloc(zx.Component, badges.len) catch {
        return (
            <span @allocator={allocator}></span>
        );
    };
    for (badges, 0..) |b, i| {
        children[i] = zx_ctx.ele(.span, .{
            .attributes = zx_ctx.attrs(.{
                zx_ctx.attr(@src(), "class", "component-badge"),
            }),
            .children = zx_ctx.chs(.{
                zx_ctx.expr(b),
            }),
        });
    }
    return zx_ctx.ele(.span, .{
        .attributes = zx_ctx.attrs(.{
            zx_ctx.attr(@src(), "class", "component-badges"),
        }),
        .children = children,
    });
}

fn ComponentItem(allocator: zx.Allocator, props: ComponentItemProps) zx.Component {
    const sel = store.selected_component;
    const dom_id = allocator.print("comp-{s}", .{props.id}) catch "";
    const padding = props.depth * 12 + 8;
    const style_str = allocator.print("padding-left: {d}px", .{padding}) catch "";
    const is_selected = std.mem.eql(u8, props.id, sel);
    const idx_str = allocator.print("{d}", .{props.occurrence}) catch "0";
    const item_class = if (is_selected) "component-root" else "component-item";
    const name_class = if (is_selected) "component-name-root" else "component-name";
    const group_class = tree.getComponentGroupClass(props.name, props.has_children, props.children, store.inputvalue);
    const badges = BuiltinBadges(allocator, props.badges);

    if (!props.has_children) {
        return (
            <div @allocator={allocator} class={group_class}>
                <div class={item_class} style={style_str}>
                    <button value={props.id} data-sel={props.selector} data-idx={idx_str} onclick={handleComponentClick} class="component-select-btn-leaf">
                        <span class="tree-arrow-spacer"></span>
                        <span class="bracket">{"<"}</span>
                        <span class={name_class}>{props.name}</span>
                        <span class="bracket">{">"}</span>
                        {badges}
                    </button>
                </div>
            </div>
        );
    }

    const toggle_checked = !data.tree_collapsed;
    return (
        <div @allocator={allocator} class={group_class}>
            <input type="checkbox" id={dom_id} class="component-toggle" checked={toggle_checked} />
            <div class={item_class} style={style_str}>
                <label for={dom_id} class="component-toggle-label">
                    <span class="tree-arrow">{icons.ChevronRight(allocator)}</span>
                </label>
                <button value={props.id} data-sel={props.selector} data-idx={idx_str} onclick={handleComponentClick} class="component-select-btn">
                    <span class="bracket">{"<"}</span>
                    <span class={name_class}>{props.name}</span>
                    <span class="bracket">{">"}</span>
                    {badges}
                </button>
            </div>
            <div class="component-children">
                {for (props.children) |child| (
                    <ComponentItem
                        allocator={allocator}
                        id={child.id}
                        name={child.name}
                        has_children={child.has_children}
                        children={child.children}
                        depth={props.depth + 1}
                        selected={std.mem.eql(u8, child.id, sel)}
                        badges={child.badges}
                        is_native={child.is_native}
                        selector={child.selector}
                        occurrence={child.occurrence}
                    />
                )}
            </div>
        </div>
    );
}

fn StateSection(allocator: zx.Allocator, props: struct { title: []const u8, items: []const StateItem }) ?zx.Component {
    if (props.items.len == 0) return null;
    const id = allocator.print("state-section-{s}", .{props.title}) catch "";
    return (
        <div @allocator={allocator} class="state-section">
            <input type="checkbox" id={id} class="state-toggle" checked />
            <label for={id} class="section-header">
                <span class="section-arrow">{icons.ChevronRight(allocator)}</span>
                <span class="section-title">{props.title}</span>
            </label>
            <div class="section-items">
                {for (props.items, 0..) |item, i| (
                    <StateItemRow
                        allocator={allocator}
                        item={item}
                        path={allocator.print("ss-{s}-{d}", .{ props.title, i }) catch ""}
                    />
                )}
            </div>
        </div>
    );
}

fn StateItemRow(allocator: zx.Allocator, props: struct { item: StateItem, depth: usize = 0, path: []const u8 }) zx.Component {
    const item = props.item;
    const has_children = item.children.len > 0;
    const value_color = format.getValueColor(item.value);
    const padding = props.depth * 12;
    const style_str = allocator.print("padding-left: {d}px", .{padding}) catch "";
    const id = allocator.print("sr-{s}", .{props.path}) catch "";
    const group_class = tree.getStateItemGroupClass(item, store.stateFilter);
    const multiline = format.isMultilineStringValue(item.value);
    const display_value = if (multiline) format.decodeJsonString(allocator, item.value) else item.value;
    return (
        <div @allocator={allocator} class={group_class} style={style_str}>
            {if (has_children) (
                <>
                    <input type="checkbox" id={id} class="state-row-toggle" />
                    <label for={id} class="state-item">
                        <span class="item-arrow">{icons.ChevronRight(allocator)}</span>
                        <span class="key-default">{item.key}</span>
                        <span class="item-colon">:</span>
                        <span class={value_color}>{item.value}</span>
                        {if (item.meta.len > 0) (<span class="item-meta">{item.meta}</span>) else ""}
                    </label>
                    <div class="state-item-children">
                        {for (item.children, 0..) |child, i| (
                            <StateItemRow
                                allocator={allocator}
                                item={child}
                                depth={props.depth + 1}
                                path={allocator.print("{s}-{d}", .{ props.path, i }) catch ""}
                            />
                        )}
                    </div>
                </>
            ) else if (multiline) (
                <div class="state-item state-item-multiline">
                    <span class="item-spacer"></span>
                    <span class="key-default">{item.key}</span>
                    <span class="item-colon">:</span>
                    <textarea class="value-multiline" readonly rows={allocator.print("{d}", .{format.countLines(display_value)}) catch "3"}>{display_value}</textarea>
                    {if (item.meta.len > 0) (<span class="item-meta">{item.meta}</span>) else ""}
                </div>
            ) else (
                <div class="state-item">
                    <span class="item-spacer"></span>
                    <span class="key-default">{item.key}</span>
                    <span class="item-colon">:</span>
                    <span class={value_color}>{item.value}</span>
                    {if (item.meta.len > 0) (<span class="item-meta">{item.meta}</span>) else ""}
                </div>
            )}
        </div>
    );
}
