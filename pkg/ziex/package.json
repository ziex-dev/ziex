{
  "name": "ziex",
  "version": "0.1.0-dev",
  "private": true,
  "description": "Ziex is a framework for building web applications with Zig.",
  "main": "src/index.ts",
  "type": "module",
  "bin": {
    "ziex": "bin/ziex"
  },
  "exports": {
    ".": "./index.js",
    "./jsx": "./jsx/index.js",
    "./wasm": "./wasm/index.js",
    "./wasm/init": "./wasm/init.js",
    "./cloudflare": "./platforms/cloudflare/index.js",
    "./aws-lambda": "./platforms/aws-lambda/index.js",
    "./vercel": "./platforms/vercel/index.js",
    "./kv": "./runtime/kv.js",
    "./db": "./runtime/db.js"
  },
  "homepage": "https://ziex.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziex-dev/ziex.git"
  },
  "keywords": [
    "zx",
    "zig",
    "web framework",
    "jsx",
    "react",
    "server components",
    "client components",
    "server actions",
    "client actions",
    "server actions"
  ],
  "author": "Nurul Huda (Apon) <me@nurulhudaapon.com>",
  "license": "MIT",
  "scripts": {
    "build": "zig build -p dist -Dfrom-source=true",
    "test": "bun test src/runtime/wire.test.ts",
    "test:jspi": "node --experimental-wasm-jspi --test src/runtime/jspi.test.ts",
    "publish": "zig build -p dist -Dfrom-source=true && cd dist && npm publish"
  },
  "dependencies": {
    "@ziex/cli": "0.1.0-dev.1252"
  }
}
