.{
    .name = .ziex,
    .version = "0.1.0-dev",
    .description = "Ziex is a framework for building web applications with Zig.",
    .repository = "https://github.com/ziex-dev/ziex",
    .homepage = "https://ziex.dev",
    .fingerprint = 0x249409a7bd1c7667,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // Ziex JS - The JavaScript glue code for csr/wasi/cloudflare/aws-lambda/vercel/react
        .ziex_js = .{
            // TODO: publish to github packages and use from there instead
            .url = "https://registry.npmjs.org/ziex/-/ziex-0.1.0-dev.1574.tgz",
            .hash = "ziex_js-0.1.0-dev-v1W0GUZABQBlAoFzVuNHoJJnbLW-x9kCrewBVPRvmEDu",
            .lazy = true,
        },
        .ziex_jsbindings = .{ .path = "pkg/ziex", .lazy = true }, // source of JS Bindings to be built with esbuild
        // httpz - HTTP server for Ziex
        .httpz = .{
            .url = "git+https://github.com/ziex-dev/httpz.git#8aeb4e522b122fd2d9ba6731480b5d3878d2845f",
            .hash = "httpz-0.0.0-PNVzrPoWCQDh-mpVLlE6Ryjobya3u-oDwOTq0aoQHdms",
            .lazy = true,
        },
        .zls = .{
            .url = "git+https://github.com/ziex-dev/zls.git#d0fb747c5a31f9e27829f5030b3dc2d601d840bd",
            .hash = "zls-0.17.0-dev-rmm5fpikJAB3znbp1hbH5xs43pte5bOkPk0-glUjgJJa",
            .lazy = true,
        },
        .lsp_kit = .{
            .url = "git+https://github.com/ziex-dev/lsp-kit.git#d148676ace1eaecf3c703ce7d350d0e94e502ed7",
            .hash = "lsp_kit-0.1.0-bi_PLwc2DACoR7VTz_qKFXUvtx7veHvWcTQvP9pDFLpk",
            .lazy = true,
        },
        .db_sqlite = .{ .path = "pkg/db-sqlite", .lazy = true },
        .db_postgres = .{ .path = "pkg/db-postgres", .lazy = true },
        .zig_js = .{ .path = "vendor/jsz" },
        .tree_sitter = .{ .path = "vendor/zig-tree-sitter" },
        .tree_sitter_zx = .{ .path = "pkg/tree-sitter-zx" },
        .tree_sitter_mdzx = .{ .path = "pkg/tree-sitter-mdzx" },
    },
    .paths = .{
        "README.md",
        "build.zig",
        "build.zig.zon",
        "src",
        "pkg/db-sqlite",
        "pkg/db-postgres",
        "pkg/tree-sitter-zx",
        "pkg/tree-sitter-mdzx",
        "pkg/ziex",
        "pkg/plugin-esbuild",
        "pkg/plugin-system",
        "pkg/plugin-typescript",
        "vendor/jsz",
        "vendor/std",
        "vendor/zig-tree-sitter",
        "templates/Template.zig",
        "templates/_base",
        "templates/_docker",
    },
}
