.{
    .name = .ziex,
    .version = "0.1.0",
    .description = "Ziex is a framework for building web applications with Zig.",
    .repository = "https://github.com/ziex-dev/ziex",
    .homepage = "https://ziex.dev",
    .fingerprint = 0x249409a7bd1c7667,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        .ziex_js = .{ .path = "pkg/ziex", .lazy = true },
        // httpz - HTTP server for Ziex
        .httpz = .{
            .url = "git+https://github.com/ziex-dev/httpz.git#e8272bfd5727aade0dcee3e2aba6c50f57c374b6",
            .hash = "httpz-0.0.0-PNVzrNAXCQDHb-rRH2jq07A3Ekv3GS6XOTkiqZJtKeqv",
            .lazy = true,
        },
        .zls = .{
            .url = "git+https://github.com/ziex-dev/zls.git#69a43b5b9c20cf5e4d11d8e175009c6de1bf80c4",
            .hash = "zls-0.17.1-dev-rmm5fjVCHAA4QkCJPbvDwmILiNT2DPUdXEp5mB4KpNgY",
            .lazy = true,
        },
        .lsp_kit = .{
            .url = "git+https://github.com/ziex-dev/lsp-kit.git#3e1058db66079911fdde82f833fdce6856e0a706",
            .hash = "lsp_kit-0.1.0-bi_PL9o2DADHS1PDra3MGz1MXnsboN_ewNvrc419z7Fb",
            .lazy = true,
        },
        .db_sqlite = .{ .path = "pkg/db-sqlite", .lazy = true },
        .db_postgres = .{ .path = "pkg/db-postgres", .lazy = true },
        .zig_js = .{ .path = "vendor/jsz" },
        .tree_sitter = .{ .path = "vendor/zig-tree-sitter" },
        .tree_sitter_zx = .{ .path = "pkg/tree-sitter-zx" },
        .tree_sitter_mdzx = .{ .path = "pkg/tree-sitter-mdzx" },
    },
    .paths = .{
        "README.md",
        "build.zig",
        "build.zig.zon",
        "src",
        "pkg/db-sqlite",
        "pkg/db-postgres",
        "pkg/tree-sitter-zx",
        "pkg/tree-sitter-mdzx",
        "pkg/ziex",
        "pkg/plugin-esbuild",
        "pkg/plugin-system",
        "pkg/plugin-typescript",
        "vendor/jsz",
        "vendor/std",
        "vendor/zig-tree-sitter",
        "templates/Template.zig",
        "templates/_base",
        "templates/_docker",
    },
}
