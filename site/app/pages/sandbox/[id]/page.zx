pub fn Page(ctx: zx.PageContext, app: Context, state: UserState) zx.Component {
    const allocator = ctx.arena;

    return (
        <div @allocator={allocator}>
            <h2>About Ziex {app.port}</h2>
            <h2>About State {state.count}</h2>
        </div>
    );
}

pub const options = zx.PageOptions{
    .methods = &.{.GET},
};

const Context = @import("../../../Context.zig");

const zx = @import("zx");
const UserState = @import("../proxy.zig").UserState;