pub const options = zx.PageOptions{
    .methods = &.{ .GET, .POST },
};

const ziex_org_url = zx.info.repository[0..(zx.info.repository.len - "/ziex".len)];

pub fn Page(ctx: zx.PageContext) !zx.Component {
    if (ctx.request.method != .GET) {
        return error.MethodNotAllowed;
    }

    const allocator = ctx.arena;
    const examples_content = @embedFile("../examples/feature_examples.zx");
    const examples = @import("../examples/feature_examples.zx");
    const util = @import("../reference/util.zig");

    const zx_greeting = util.extractSection(allocator, examples_content, "Learn: greeting");
    const zig_greeting = zx_greeting;

    const zx_markup = util.extractSection(allocator, examples_content, "Learn: markup");
    const zig_markup = zx_markup;

    const zx_text = util.extractSection(allocator, examples_content, "Learn: text expression");
    const zig_text = zx_text;

    const zx_format = util.extractSection(allocator, examples_content, "Learn: format expression");
    const zig_format = zx_format;

    const zx_conditional = util.extractSection(allocator, examples_content, "Learn: conditional");
    const zig_conditional = zx_conditional;

    const zx_switch = util.extractSection(allocator, examples_content, "Learn: switch");
    const zig_switch = zx_switch;

    const zx_list = util.extractSection(allocator, examples_content, "Learn: list");
    const zig_list = zx_list;

    const zx_props = util.extractSection(allocator, examples_content, "Learn: props");
    const zig_props = zx_props;

    const zx_page = util.extractSection(allocator, examples_content, "Learn: page");
    const zig_page = zx_page;

    const zx_layout = util.extractSection(allocator, examples_content, "Learn: layout");

    const build_manual_code = util.extractSection(allocator, examples_content, "Learn: build manual");

    const zx_dynamic = util.extractSection(allocator, examples_content, "Learn: dynamic route");
    const zig_dynamic = zx_dynamic;

    const zx_fragment = util.extractSection(allocator, examples_content, "Learn: fragment");
    const zig_fragment = zx_fragment;

    const zx_children = util.extractSection(allocator, examples_content, "Learn: children");
    const zig_children = zx_children;

    const zx_dynattr = util.extractSection(allocator, examples_content, "Learn: dynamic attributes");
    const zig_dynattr = zx_dynattr;

    const zx_onclick = util.extractSection(allocator, examples_content, "Learn: onclick");
    const zx_onclick_state = util.extractSection(allocator, examples_content, "Client-side Rendering");
    const zx_state_mgmt = util.extractSection(allocator, examples_content, "Learn: state management");

    const zig_api = util.extractSection(allocator, examples_content, "Learn: api route");

    const kv_basic = util.extractSection(allocator, examples_content, "Learn: kv basic");
    const kv_typed = util.extractSection(allocator, examples_content, "Learn: kv typed");
    const kv_scoped = util.extractSection(allocator, examples_content, "Learn: kv scoped");

    const db_basic = util.extractSection(allocator, examples_content, "Learn: db basic");
    const db_typed = util.extractSection(allocator, examples_content, "Learn: db typed");
    const db_transaction = util.extractSection(allocator, examples_content, "Learn: db transaction");

    const enable_kv_build = util.extractUnwrapSection(allocator, examples_content, "Learn: enable kv");
    const enable_db_build = util.extractUnwrapSection(allocator, examples_content, "Learn: enable db");

    const template_attrs_example = util.extractUnwrapSection(allocator, examples_content, "Learn: template attrs");
    const spread_attrs_example = util.extractUnwrapSection(allocator, examples_content, "Learn: spread attrs");
    const client_action_example = util.extractSection(allocator, examples_content, "Learn: client action");
    const server_action_example = util.extractSection(allocator, examples_content, "Learn: server action");

    const html_greeting = util.renderComponentToHtml(allocator, examples.Learn__HelloWorld(allocator));
    const html_markup = util.renderComponentToHtml(allocator, examples.Learn__AboutSection(allocator));
    const html_text = util.renderComponentToHtml(allocator, examples.Learn__UserGreeting(allocator));
    const html_format = util.renderComponentToHtml(allocator, examples.Learn__ProductInfo(allocator));
    const html_conditional = util.renderComponentToHtml(allocator, examples.Learn__UserStatus(allocator));
    const html_switch = util.renderComponentToHtml(allocator, examples.Learn__RoleBadge(allocator));
    const html_list = util.renderComponentToHtml(allocator, examples.Learn__ProductList(allocator));
    const html_props = util.renderComponentToHtml(allocator, examples.Learn__ButtonDemo(allocator));
    const html_page = util.renderComponentToHtml(allocator, examples.Learn__Page(ctx));
    const html_dynamic = util.renderComponentToHtml(allocator, examples.Learn__UserProfile(ctx));
    const html_fragment = util.renderComponentToHtml(allocator, examples.Learn__FragmentDemo(allocator));
    const html_children = util.renderComponentToHtml(allocator, examples.Learn__CardDemo(allocator));
    const html_dynattr = util.renderComponentToHtml(allocator, examples.Learn__DynamicAttrs(allocator));
    const html_onclick = util.renderComponentToHtml(allocator, examples.Learn__Interactivity(allocator));
    const html_onclick_state = util.renderComponentToHtml(allocator, examples.Client(allocator));
    const html_state_mgmt = util.renderComponentToHtml(allocator, examples.Learn__StateDemo(allocator));

    const layout_ctx = zx.LayoutContext{
        .request = ctx.request,
        .response = ctx.response,
        .allocator = allocator,
        .arena = allocator,
        .io = ctx.io,
    };
    const html_layout = util.renderComponentToHtml(allocator, examples.Learn__Layout(layout_ctx, examples.Learn__Page(ctx)));

    const preview_onclick = examples.Learn__Interactivity(allocator);
    const preview_onclick_state = examples.Client(allocator);
    const preview_state_mgmt = examples.Learn__StateDemo(allocator);

    return (
        <fragment @{allocator}>
            <LearnHeader />
            // <YouWillLearn />
            <Installation />
            <CreateProject build_manual_code={build_manual_code} />
            <EditorSetup />
            <CreatingComponents zx_code={zx_greeting} zig_code={zig_greeting} html_code={html_greeting} />
            <WritingMarkup zx_code={zx_markup} zig_code={zig_markup} html_code={html_markup} />
            <Fragments zx_code={zx_fragment} zig_code={zig_fragment} html_code={html_fragment} />
            <DisplayingData zx_text={zx_text} zig_text={zig_text} html_text={html_text} zx_format={zx_format} zig_format={zig_format} html_format={html_format} />
            <DynamicAttributes zx_code={zx_dynattr} zig_code={zig_dynattr} html_code={html_dynattr} template_example={template_attrs_example} spread_example={spread_attrs_example} />
            <Interactivity zx_onclick={zx_onclick} html_onclick={html_onclick} zx_onclick_state={zx_onclick_state} html_onclick_state={html_onclick_state} zx_state_mgmt={zx_state_mgmt} html_state_mgmt={html_state_mgmt} preview_onclick={preview_onclick} preview_onclick_state={preview_onclick_state} preview_state_mgmt={preview_state_mgmt} client_action_example={client_action_example} server_action_example={server_action_example} />
            <ConditionalRendering zx_conditional={zx_conditional} zig_conditional={zig_conditional} html_conditional={html_conditional} zx_switch={zx_switch} zig_switch={zig_switch} html_switch={html_switch} />
            <RenderingLists zx_code={zx_list} zig_code={zig_list} html_code={html_list} />
            <PassingProps zx_code={zx_props} zig_code={zig_props} html_code={html_props} />
            <ChildrenProps zx_code={zx_children} zig_code={zig_children} html_code={html_children} />
            <PagesAndLayouts zx_page={zx_page} zig_page={zig_page} html_page={html_page} zx_layout={zx_layout} html_layout={html_layout} zx_dynamic={zx_dynamic} zig_dynamic={zig_dynamic} html_dynamic={html_dynamic} />
            <APIRoutes zig_code={zig_api} />
            <KVStorage kv_basic={kv_basic} kv_typed={kv_typed} kv_scoped={kv_scoped} enable_build={enable_kv_build} />
            <Database db_basic={db_basic} db_typed={db_typed} db_transaction={db_transaction} enable_build={enable_db_build} />
            <Deployment />
            <NextSteps />
        </fragment>
    );
}

fn LearnHeader(allocator: zx.Allocator) zx.Component {
    return (
        <section class="section learn-header docs-page-header" @allocator={allocator}>
            <p class="section-category">Learn</p>
            <h1>Quick Start</h1>
            <p class="lead">An introduction to the core concepts you'll use daily when building with ZX.</p>
        </section>
    );
}

fn YouWillLearn(allocator: zx.Allocator) zx.Component {
    return (
        <div class="callout learn-callout" @allocator={allocator}>
            <p class="callout-title"><strong>You will learn</strong></p>
            <ul>
                <li>How to install ZX and set up your environment</li>
                <li>How to create and nest components</li>
                <li>How to write markup and use fragments</li>
                <li>How to display data with expressions</li>
                <li>How to use dynamic attributes</li>
                <li>How to render conditionally and render lists</li>
                <li>How to pass props and children to components</li>
                <li>How to create pages, layouts, and dynamic routes</li>
                <li>How to create API routes</li>
            </ul>
        </div>
    );
}

const Versions = struct {
    pub const Release = struct {
        version: []const u8,
        minimum_zig_version: []const u8,
        branch: []const u8,
        status: ReleaseStatus,
    };

    pub const ReleaseStatus = enum {
        current,
        latest,
        development,
        stale,
    };

    releases: []const Release,
};

const versions: Versions = @import("../versions.zon");

fn Installation(allocator: zx.Allocator) !zx.Component {
    return (
        <section id="installation" class="section" @allocator={allocator}>
            <h2>Installation</h2>
            <p>Install the ZX CLI to get started:</p>

            <InstallCLI />

            <p style="margin-top: 1rem;">You can also scaffold a project with <a href="#create-project">Node.js</a>, clone a <a href="#create-project">starter template</a>, or set things up <a href="#create-project">manually</a>. See <a href="#create-project">Create a Project</a> for all options.</p>

            <h3>Install Zig</h3>
            <p>Ziex <code>{zx.info.version}</code> requires Zig <code>{zx.info.minimum_zig_version}</code>:</p>

            <p>Other available versions:</p>
            <ul>
                {for (versions.releases) |release| (
                    <li><a href=`{zx.info.repository}/releases/tag/v{release.version}` target="_blank" rel="noopener noreferrer">{release.version}</a> (requires Zig {release.minimum_zig_version})</li>
                )}
            </ul>

            <InstallZig />
        </section>
    );
}

const CreateProjectProps = struct {
    build_manual_code: []const u8,
};

fn CreateProject(allocator: zx.Allocator, props: CreateProjectProps) zx.Component {
    return (
        <section id="create-project" class="section" @allocator={allocator}>
            <h2>Create a Project</h2>
            <p>Pick the setup that fits your workflow:</p>
            <ul>
                <li><strong>CLI</strong> - scaffold a project with <code>zx init</code></li>
                <li><strong>Template</strong> - clone the starter repo and run <code>zig build dev</code></li>
                <li><strong>Manual</strong> - add ZX to an existing Zig project with <code>build.zig</code></li>
                <li><strong>Node.js</strong> - use <code>npm init ziex</code> or <code>bun create ziex</code> to download a template</li>
            </ul>
            <div>
                <div class="simple-tab-header">
                    <input type="radio" id="tab-cli" name="create-project" class="simple-tab-radio" checked="true" aria-label="CLI setup method" />
                    <input type="radio" id="tab-template" name="create-project" class="simple-tab-radio" aria-label="Template setup method" />
                    <input type="radio" id="tab-manual" name="create-project" class="simple-tab-radio" aria-label="Manual setup method" />
                    <input type="radio" id="tab-nodejs" name="create-project" class="simple-tab-radio" aria-label="Node.js setup method" />
                    <label for="tab-cli" class="simple-tab-label">CLI</label>
                    <label for="tab-template" class="simple-tab-label">Template</label>
                    <label for="tab-manual" class="simple-tab-label">Manual</label>
                    <label for="tab-nodejs" class="simple-tab-label">Node.js</label>
                </div>
                <div class="simple-tab-content" id="content-cli">
                    <p>Create a new ZX project using the CLI:</p>
                    <div class="install-box install-box-simple">
                        <div class="install-box-content">
                            <div class="install-code" style="min-height: 28px; margin-top: 5px;">
                                <span class="install-prompt">$ </span>
                                <span class="function">zx</span>
                                <span class="operator"> init </span>
                                <span class="variable">my-app</span>
                            </div>
                        </div>
                    </div>

                    <p style="margin-top: 1.5rem;">Start the ZX app in development mode with hot reloading:</p>
                    <div class="install-box install-box-simple">
                        <div class="install-box-content">
                            <div class="install-code install-code-multiline">
                                <div><span class="install-prompt">$ </span><span class="function">cd </span><span class="variable">my-app</span></div>
                                <div><span class="install-prompt">$ </span><span class="function">zig </span><span class="operator">build </span><span class="variable">dev</span></div>
                            </div>
                        </div>
                    </div>

                    <p style="margin-top: 1.5rem;">Open <code>http://localhost:3000</code> in your browser!</p>
                </div>
                <div class="simple-tab-content" id="content-template">
                    <p>Clone the starter template from GitHub:</p>
                    <div class="install-box install-box-simple">
                        <div class="install-box-content">
                            <div class="install-code install-code-multiline">
                                <div><span class="install-prompt">$ </span><span class="function">git </span><span class="operator">clone </span><span class="variable">{ziex_org_url}/template-starter </span><span class="variable">my-app</span></div>
                                <div><span class="install-prompt">$ </span><span class="function">cd </span><span class="variable">my-app</span></div>
                            </div>
                        </div>
                    </div>

                    <p style="margin-top: 1.5rem;">Start the app in development mode with hot reloading:</p>
                    <div class="install-box install-box-simple">
                        <div class="install-box-content">
                            <div class="install-code">
                                <span class="install-prompt">$ </span>
                                <span class="function">zig </span>
                                <span class="operator">build </span>
                                <span class="variable">dev</span>
                            </div>
                        </div>
                    </div>

                    <p style="margin-top: 1.5rem;">Open <code>http://localhost:3000</code> in your browser!</p>
                </div>
                <div class="simple-tab-content" id="content-manual">
                    <p>First, initialize a Zig project if you haven't already:</p>
                    <div class="install-box install-box-simple">
                        <div class="install-box-content">
                            <div class="install-code">
                                <span class="install-prompt">$ </span>
                                <span class="function">zig</span>
                                <span class="operator"> init</span>
                            </div>
                        </div>
                    </div>

                    <p style="margin-top: 1.5rem;">Add ZX as a dependency:</p>
                    <div class="install-box install-box-simple">
                        <div class="install-box-content">
                            <div class="install-code">
                                <span class="install-prompt">$ </span>
                                <span class="function">zig</span>
                                <span class="operator"> fetch </span>
                                <span class="operator">--save </span>
                                <span class="variable">git+{zx.info.repository}</span>
                            </div>
                        </div>
                    </div>

                    <p>Update your <code translate="no">build.zig</code> to the following:</p>
                    <CodeBlock code={props.build_manual_code} filename="build.zig" translate="no" /> 

                    <p style="margin-top: 1.5rem;">Then initialize the project with the default template:</p>
                    <div class="install-box install-box-simple">
                        <div class="install-box-content">
                            <div class="install-code">
                                <span class="install-prompt">$ </span>
                                <span class="function">zig</span>
                                <span class="operator"> build </span>
                                <span class="variable">zx</span>
                                <span class="operator"> -- </span>
                                <span class="function">init</span>
                                <span class="operator"> --existing</span>
                            </div>
                        </div>
                    </div>

                    <p style="margin-top: 1.5rem;">Start the ZX app in development mode with hot reloading:</p>
                    <div class="install-box install-box-simple">
                        <div class="install-box-content">
                            <div class="install-code install-code-multiline">
                                <div><span class="install-prompt">$ </span><span class="function">zig </span><span class="operator">build </span><span class="variable">dev</span></div>
                            </div>
                        </div>
                    </div>

                    <p style="margin-top: 1.5rem;">Open <code>http://localhost:3000</code> in your browser!</p>
                </div>
                <div class="simple-tab-content" id="content-nodejs">
                    <p>Create a new project with npm or Bun. You'll be prompted to pick a template:</p>
                    <div class="install-box install-box-simple">
                        <div class="install-box-content">
                            <div class="install-code">
                                <span class="install-prompt">$ </span>
                                <span class="function">npm</span>
                                <span class="operator"> init </span>
                                <span class="variable">ziex</span>
                            </div>
                        </div>
                    </div>

                    <p style="margin-top: 1.5rem;">Then cd into your project and start the dev server:</p>
                    <div class="install-box install-box-simple">
                        <div class="install-box-content">
                            <div class="install-code install-code-multiline">
                                <div><span class="install-prompt">$ </span><span class="function">cd </span><span class="variable">my-app</span></div>
                                <div><span class="install-prompt">$ </span><span class="function">zig </span><span class="operator">build </span><span class="variable">dev</span></div>
                            </div>
                        </div>
                    </div>

                    <p style="margin-top: 1.5rem;">If you chose the <code>node</code> template, install dependencies and use the npm scripts instead:</p>
                    <div class="install-box install-box-simple">
                        <div class="install-box-content">
                            <div class="install-code install-code-multiline">
                                <div><span class="install-prompt">$ </span><span class="function">npm </span><span class="operator">install</span></div>
                                <div><span class="install-prompt">$ </span><span class="function">npm </span><span class="operator">run </span><span class="variable">dev</span></div>
                            </div>
                        </div>
                    </div>

                    <p style="margin-top: 1.5rem;">Open <code>http://localhost:3000</code> in your browser!</p>
                </div>
            </div>

            <h3>Project Structure</h3>
            <ProjectTree />
            <div class="callout tip">
                <strong>Tip:</strong>{" "}The <code>app/pages/</code>{" "}directory uses file-based routing. Each <code>page.zx</code>{" "}file becomes a route.
            </div>
        </section>
    );
}

fn EditorSetup(allocator: zx.Allocator) zx.Component {
    return (
        <section id="editor-setup" class="section" @allocator={allocator}>
            <h2>Editor Setup</h2>
            <p>Set up your editor for the best ZX development experience.</p>
            <div>
                <div class="simple-tab-header">
                    <input type="radio" id="tab-editor-vscode" name="editor-setup" class="simple-tab-radio" checked="true" aria-label="VS Code / Cursor" />
                    <input type="radio" id="tab-editor-neovim" name="editor-setup" class="simple-tab-radio" aria-label="Neovim" />
                    <input type="radio" id="tab-editor-helix" name="editor-setup" class="simple-tab-radio" aria-label="Helix" />
                    <input type="radio" id="tab-editor-zed" name="editor-setup" class="simple-tab-radio" aria-label="Zed" />
                    <input type="radio" id="tab-editor-emacs" name="editor-setup" class="simple-tab-radio" aria-label="Emacs" />
                    <label for="tab-editor-vscode" class="simple-tab-label">VS Code</label>
                    <label for="tab-editor-neovim" class="simple-tab-label">Neovim</label>
                    <label for="tab-editor-helix" class="simple-tab-label">Helix</label>
                    <label for="tab-editor-zed" class="simple-tab-label">Zed</label>
                    <label for="tab-editor-emacs" class="simple-tab-label">Emacs</label>
                </div>
                <div class="simple-tab-content" id="content-editor-vscode">
                    <p>Install the official ZX extension for the best development experience.</p>
                    <p>Install from:</p>
                    <ul>
                        <li><a href="https://marketplace.visualstudio.com/items?itemName=ziex.ziex" target="_blank" rel="noopener noreferrer">VS Code Marketplace</a></li>
                        <li><a href="https://open-vsx.org/extension/ziex/ziex" target="_blank" rel="noopener noreferrer">Open VSX Registry</a> (for Cursor and other forks)</li>
                    </ul>
                    <p>Or from the command palette: <code>ext install ziex.ziex</code></p>
                    <p><strong>Features:</strong> Syntax highlighting, IntelliSense, error diagnostics, bracket matching, and code folding.</p>
                </div>
                <div class="simple-tab-content" id="content-editor-neovim">
                    <p>With <a href="https://github.com/folke/lazy.nvim" target="_blank" rel="noopener noreferrer">lazy.nvim</a>, add <code>{zx.info.repository["https://github.com/".len..]}</code> as a plugin with <code>nvim-treesitter</code> as a dependency.</p>
                    <p>See the <a href=`{zx.info.repository}/tree/main/ide/neovim` target="_blank" rel="noopener noreferrer">Neovim setup guide</a> for the full configuration.</p>
                    <p><strong>Features:</strong> Tree-sitter syntax highlighting, LSP support, and file icons.</p>
                </div>
                <div class="simple-tab-content" id="content-editor-helix">
                    <p>See the <a href=`{zx.info.repository}/tree/main/ide/helix` target="_blank" rel="noopener noreferrer">Helix setup guide</a> for the full configuration.</p>
                    <p><strong>Features:</strong> Tree-sitter syntax highlighting and LSP support.</p>
                </div>
                <div class="simple-tab-content" id="content-editor-zed">
                    <p>Manual installation (pending marketplace approval):</p>
                    <ol>
                        <li>Clone: <code>git clone {zx.info.repository}</code></li>
                        <li>Open Extensions panel (Cmd/Ctrl + Shift + P)</li>
                        <li>Select "Install Dev Extension"</li>
                        <li>Navigate to <code>ide/zed</code> in the cloned repo</li>
                    </ol>
                    <p>See the <a href=`{zx.info.repository}/tree/main/ide/zed` target="_blank" rel="noopener noreferrer">Zed setup guide</a> for details.</p>
                </div>
                <div class="simple-tab-content" id="content-editor-emacs">
                    <p>Add <code>ide/emacs</code> from a checkout to your <code>load-path</code> and run <code>M-x zx-ts-mode-install-grammar</code> once to build the grammar.</p>
                    <p>See the <a href=`{zx.info.repository}/tree/main/ide/emacs` target="_blank" rel="noopener noreferrer">Emacs setup guide</a> for the full configuration, including the required <code>libtree-sitter</code> version.</p>
                    <p><strong>Features:</strong> Tree-sitter syntax highlighting, indentation, imenu, and LSP support via Eglot.</p>
                </div>
            </div>

            <h3 id="devtools">Browser DevTools</h3>
            <p>Install the <a href="https://chromewebstore.google.com/detail/ziex-devtools/efnedneccooengjfmahlnmicgkalnopj" target="_blank" rel="noopener noreferrer">Ziex DevTools</a> Chrome extension to inspect and debug ZX applications from Chrome DevTools.</p>

            <script src=`/assets/docs.js?v={zx.info.version}` defer="true"></script>
        </section>
    );
}

const CreatingComponentsProps = struct {
    zx_code: []const u8,
    zig_code: []const u8,
    html_code: []const u8,
};

fn CreatingComponents(allocator: zx.Allocator, props: CreatingComponentsProps) zx.Component {
    return (
        <section id="creating-components" class="section" @allocator={allocator}>
            <h2>Creating and nesting components</h2>
            <p>ZX apps are made out of <em>components</em>. A component is a function that returns a <code>zx.Component</code> type. Components can be as small as a button or as large as an entire page.</p>
            <p>ZX components are Zig functions that return markup. Notice how <code>{"<Greeting />"}</code> starts with a capital letter - that's how ZX distinguishes between custom components and HTML elements:</p>
            <ExampleBlock id="greeting" zx_code={props.zx_code} zig_code={props.zig_code} html_code={props.html_code} filename="hello_world.zx" />
            <div class="callout note">
                <strong>Note:</strong>{" "}Every component needs an allocator for memory management. The <code>@allocator</code>{" "}attribute must be set on the root element of each component. Child components inherit the allocator from their parent. See the <a href="/reference#allocator">@allocator documentation</a> for details.
            </div>
        </section>
    );
}

const WritingMarkupProps = struct {
    zx_code: []const u8,
    zig_code: []const u8,
    html_code: []const u8,
};

fn WritingMarkup(allocator: zx.Allocator, props: WritingMarkupProps) zx.Component {
    return (
        <section id="writing-markup" class="section" @allocator={allocator}>
            <h2>Writing markup with ZX</h2>
            <p>The markup syntax is called <em>ZX</em> - it's similar to JSX but designed for Zig. ZX files use the <code>.zx</code> extension and are transpiled to efficient Zig code.</p>
            <p>ZX is stricter than HTML. You have to close all tags, including self-closing ones like <code>{"<br />"}</code>:</p>
            <ExampleBlock id="markup" zx_code={props.zx_code} zig_code={props.zig_code} html_code={props.html_code} filename="about_section.zx" />
            <p>CSS classes are specified with the <code>class</code> attribute, same as HTML. Write your CSS in separate files and include them in your layout.</p>
            <p>ZX automatically escapes HTML content for security. If you need to render raw HTML, see the <a href="/reference#escaping">@escaping documentation</a>.</p>
        </section>
    );
}

const FragmentsProps = struct {
    zx_code: []const u8,
    zig_code: []const u8,
    html_code: []const u8,
};

fn Fragments(allocator: zx.Allocator, props: FragmentsProps) zx.Component {
    return (
        <section id="fragments" class="section" @allocator={allocator}>
            <h2>Fragments</h2>
            <p>Sometimes you want to return multiple elements from a component without adding an extra wrapper. Use the empty tag syntax <code>{"<>"}...{"</>"}</code>:</p>
            <ExampleBlock id="fragment" zx_code={props.zx_code} zig_code={props.zig_code} html_code={props.html_code} filename="fragment_demo.zx" />
            <p>Fragments are useful when you need to group elements but don't want to add extra DOM nodes. The children are rendered directly without any wrapper element. Learn more in the <a href="/reference#fragments">Fragments documentation</a>.</p>
        </section>
    );
}

const DisplayingDataProps = struct {
    zx_text: []const u8,
    zig_text: []const u8,
    html_text: []const u8,
    zx_format: []const u8,
    zig_format: []const u8,
    html_format: []const u8,
};

fn DisplayingData(allocator: zx.Allocator, props: DisplayingDataProps) zx.Component {
    return (
        <section id="displaying-data" class="section" @allocator={allocator}>
            <h2>Displaying data</h2>
            <p>ZX lets you embed dynamic content using curly braces <code>{"{expression}"}</code>. Expressions are automatically formatted based on their type:</p>
            <ul>
                <li><strong>Strings</strong> - displayed as text (HTML-escaped for safety)</li>
                <li><strong>Numbers</strong> - formatted as decimal</li>
                <li><strong>Booleans</strong> - displayed as "true" or "false"</li>
                <li><strong>Enums</strong> - displayed as the tag name</li>
                <li><strong>Optionals</strong> - unwrapped if present, otherwise renders nothing</li>
            </ul>
            <ExampleBlock id="text-expr" zx_code={props.zx_text} zig_code={props.zig_text} html_code={props.html_text} filename="user_greeting.zx" />
            <p>Different types are automatically handled:</p>
            <ExampleBlock id="format-expr" zx_code={props.zx_format} zig_code={props.zig_format} html_code={props.html_format} filename="product_info.zx" />
            <p>See the <a href="/reference#expressions">Expressions documentation</a> for detailed information on all supported types including components and component arrays.</p>
        </section>
    );
}

const DynamicAttributesProps = struct {
    zx_code: []const u8,
    zig_code: []const u8,
    html_code: []const u8,
    template_example: []const u8,
    spread_example: []const u8,
};

fn DynamicAttributes(allocator: zx.Allocator, props: DynamicAttributesProps) zx.Component {
    return (
        <section id="dynamic-attributes" class="section" @allocator={allocator}>
            <h2>Dynamic attributes</h2>
            <p>Use curly braces to pass dynamic values to HTML attributes:</p>
            <ExampleBlock id="dynamic-attr" zx_code={props.zx_code} zig_code={props.zig_code} html_code={props.html_code} filename="dynamic_attrs.zx" />
            <p>You can use any expression, including conditionals, to compute attribute values dynamically.</p>

            <h3>Template strings</h3>
            <p>Use backticks for string interpolation in attributes:</p>
            <CodeBlock code={props.template_example} />

            <h3>Spread and shorthand</h3>
            <p>Use <code>{"{..struct}"}</code> to spread struct fields as attributes, or <code>{"{variable}"}</code> as shorthand when the attribute name matches the variable:</p>
            <CodeBlock code={props.spread_example} />
            <p>See the <a href="/reference#attribute-syntax">Attribute Syntax documentation</a> for more details. ZX also provides special <a href="/reference#builtin-attributes">builtin attributes</a> like <code>@allocator</code>, <code>@escaping</code>, and <code>@rendering</code>.</p>
        </section>
    );
}

const InteractivityProps = struct {
    zx_onclick: []const u8,
    html_onclick: []const u8,
    zx_onclick_state: []const u8,
    html_onclick_state: []const u8,
    zx_state_mgmt: []const u8,
    html_state_mgmt: []const u8,
    preview_onclick: zx.Component,
    preview_onclick_state: zx.Component,
    preview_state_mgmt: zx.Component,
    client_action_example: []const u8,
    server_action_example: []const u8,
};

fn Interactivity(allocator: zx.Allocator, props: InteractivityProps) zx.Component {
    return (
        <section id="interactivity" class="section" @allocator={allocator}>
            <h2>Adding interactivity</h2>
            <p>Interactivity can be added using native HTML attributes. Provide a function as a handler for the event and take action on that event.</p>

            <h3>Event handlers</h3>
            <p>Attach event handlers to elements using the <code>{"on<event_name>"}</code> syntax:</p>
            <ExampleBlock id="onclick" zx_code={props.zx_onclick} html_code={props.html_onclick} filename="events.zig" preview_component={props.preview_onclick} />
            <p>Common event handlers include <code>onclick</code>, <code>onsubmit</code>, <code>onchange</code>, <code>onblur</code>, and more. Handler functions receive a <code>zx.client.Event</code> parameter with access to the DOM event object.</p>

            <h3>Binding state to events</h3>
            <p>To update component state in response to events, use <code>ctx.bind(handler)</code> and access state through the event handler:</p>
            <ExampleBlock id="onclick-state" zx_code={props.zx_onclick_state} html_code={props.html_onclick_state} filename="events.zig" preview_component={props.preview_onclick_state} />
            <p>When you use <code>ctx.bind()</code>, the handler receives a <code>zx.client.Event.Stateful</code> which provides access to component state through <code>event.state(T)</code>. Call <code>state(T)</code> in the same order as the <code>ctx.state()</code> calls in the component; the types must match.</p>
            <div class="callout note">
                <strong>Note:</strong>{" "}For event handlers to run in the browser, <code>@rendering={"{.client}"}</code>{" "}must be set on the interactive component or a parent that wraps it. Without it, the component renders server-side only and event handlers are ignored.
            </div>

            <h3 id="form-actions">Form actions</h3>
            <p>For form submissions, prefer the <code>action</code> attribute with an Action handler. Actions parse form fields into a typed struct via <code>data(T)</code>, instead of reading the raw DOM event.</p>

            <h4 id="client-actions">Client actions</h4>
            <p>Use <code>zx.client.Action</code> (or <code>*zx.client.Action.Stateful</code> with <code>ctx.bind()</code>) when the form should be handled in the browser:</p>
            <CodeBlock code={props.client_action_example} filename="contact_form.zx" />
            <p><code>a.data(T)</code>{" "}maps each form field name to a struct field. Supported field types include strings, ints, floats, bools, optionals, and <code>[]const []const u8</code>{" "}for repeated fields.</p>

            <h4 id="server-actions">Server actions</h4>
            <p>Use <code>zx.server.Action</code> when the form should be handled on the server. Point <code>action</code>{" "}at the handler directly (no <code>ctx.bind()</code>{" "}needed for a plain server action):</p>
            <CodeBlock code={props.server_action_example} filename="login_form.zx" />
            <p>Server actions also expose <code>request</code>, <code>response</code>, and <code>arena</code>. Use <code>*zx.server.Action.Stateful</code>{" "}with <code>ctx.bind()</code>{" "}when the handler needs component state. See the <a href="/reference#form-actions">Form Actions reference</a>{" "}for details.</p>
        </section>
    );
}

const ConditionalRenderingProps = struct {
    zx_conditional: []const u8,
    zig_conditional: []const u8,
    html_conditional: []const u8,
    zx_switch: []const u8,
    zig_switch: []const u8,
    html_switch: []const u8,
};

fn ConditionalRendering(allocator: zx.Allocator, props: ConditionalRenderingProps) zx.Component {
    return (
        <section id="conditional-rendering" class="section" @allocator={allocator}>
            <h2>Conditional rendering</h2>
            <p>Use Zig's <code>if</code> expressions to conditionally render content:</p>
            <ExampleBlock id="conditional" zx_code={props.zx_conditional} zig_code={props.zig_conditional} html_code={props.html_conditional} filename="user_status.zx" />

            <h3>Switch expressions</h3>
            <p>Use <code>switch</code> expressions to match against enum values. Each case can return text or a component:</p>
            <ExampleBlock id="switch-expr" zx_code={props.zx_switch} zig_code={props.zig_switch} html_code={props.html_switch} filename="role_badge.zx" />
            <p>ZX also supports <code>while</code> loops for conditional iteration. See the <a href="/reference#control-flow">Control Flow documentation</a> for all patterns.</p>
        </section>
    );
}

const RenderingListsProps = struct {
    zx_code: []const u8,
    zig_code: []const u8,
    html_code: []const u8,
};

fn RenderingLists(allocator: zx.Allocator, props: RenderingListsProps) zx.Component {
    return (
        <section id="rendering-lists" class="section" @allocator={allocator}>
            <h2>Rendering lists</h2>
            <p>Use <code>for</code> loops to iterate over arrays and render a component for each item:</p>
            <ExampleBlock id="list" zx_code={props.zx_code} zig_code={props.zig_code} html_code={props.html_code} filename="product_list.zx" />
            <p>The loop variable can be used within the component body to display item-specific content. See the <a href="/reference#for-loops">For Loops documentation</a> for more examples.</p>
        </section>
    );
}

const PassingPropsProps = struct {
    zx_code: []const u8,
    zig_code: []const u8,
    html_code: []const u8,
};

fn PassingProps(allocator: zx.Allocator, props: PassingPropsProps) zx.Component {
    return (
        <section id="passing-props" class="section" @allocator={allocator}>
            <h2>Passing props to components</h2>
            <p>Components can accept <em>props</em> (properties) to customize their behavior. Define a props struct as the second parameter:</p>
            <ExampleBlock id="props" zx_code={props.zx_code} zig_code={props.zig_code} html_code={props.html_code} filename="button_demo.zx" />
            <p>ZX automatically coerces attributes to the props struct. Fields with default values are optional. See the <a href="/reference#components">Components documentation</a> for more on props coercion.</p>
            <h3>Component signatures</h3>
            <ul>
                <li><strong>Allocator only:</strong> <code>fn Component(allocator: zx.Allocator) zx.Component</code></li>
                <li><strong>With props:</strong> <code>fn Component(allocator: zx.Allocator, props: Props) zx.Component</code></li>
            </ul>
        </section>
    );
}

const ChildrenPropsProps = struct {
    zx_code: []const u8,
    zig_code: []const u8,
    html_code: []const u8,
};

fn ChildrenProps(allocator: zx.Allocator, props: ChildrenPropsProps) zx.Component {
    return (
        <section id="children" class="section" @allocator={allocator}>
            <h2>Passing children to components</h2>
            <p>Components can accept <em>children</em> - content passed between opening and closing tags. Add a <code>children: zx.Component</code> field to your props:</p>
            <ExampleBlock id="children" zx_code={props.zx_code} zig_code={props.zig_code} html_code={props.html_code} filename="card_demo.zx" />
            <p>This pattern is useful for creating wrapper components like cards, modals, or layout containers. See the <a href="/reference#children-props">Children Props documentation</a> for more details.</p>
        </section>
    );
}

const PagesAndLayoutsProps = struct {
    zx_page: []const u8,
    zig_page: []const u8,
    html_page: []const u8,
    zx_layout: []const u8,
    html_layout: []const u8,
    zx_dynamic: []const u8,
    zig_dynamic: []const u8,
    html_dynamic: []const u8,
};

fn PagesAndLayouts(allocator: zx.Allocator, props: PagesAndLayoutsProps) zx.Component {
    return (
        <section id="pages-layouts" class="section" @allocator={allocator}>
            <h2>Pages and Layouts</h2>
            <p>ZX uses file-based routing. Create <code>page.zx</code> files in the <code>app/pages/</code> directory:</p>
            <ExampleBlock id="page-example" zx_code={props.zx_page} zig_code={props.zig_page} html_code={props.html_page} filename="page.zx" />
            <p>The file path determines the URL: <code>app/pages/about/page.zx</code> → <code>/about</code></p>

            <h3>Dynamic routes</h3>
            <p>Use brackets <code>[param]</code> in folder names to create dynamic segments:</p>
            <ul>
                <li><code>app/pages/user/[id]/page.zx</code> → <code>/user/:id</code></li>
                <li><code>app/pages/blog/[slug]/page.zx</code> → <code>/blog/:slug</code></li>
            </ul>
            <p>Access the parameter value using <code>ctx.request.params.get("name")</code>:</p>
            <ExampleBlock id="dynamic-route" zx_code={props.zx_dynamic} zig_code={props.zig_dynamic} html_code={props.html_dynamic} filename="user/[id]/user_profile.zx" />

            <h3>Creating layouts</h3>
            <p>Layouts wrap pages with common UI. Create a <code>layout.zx</code> file:</p>
            <ExampleBlock id="layout-example" files={layoutFiles(allocator, props.zx_layout, props.zx_page)} zig_code={props.zx_layout} html_code={props.html_layout} />

            <h3>PageContext and LayoutContext</h3>
            <p>Both contexts provide:</p>
            <ul>
                <li><code>request</code> - HTTP request with headers, query params, body</li>
                <li><code>response</code> - HTTP response for setting headers</li>
                <li><code>arena</code> - Request-scoped allocator (recommended)</li>
                <li><code>allocator</code> - Global allocator for persistent allocations</li>
            </ul>
            <div class="callout tip">
                <strong>Best practice:</strong>{" "}Use <code>ctx.arena</code>{" "}for allocations - it's automatically freed after the request.
            </div>
            <p>See the <a href="/reference#routing">Routing documentation</a> for detailed information on pages, layouts, and dynamic routes.</p>
        </section>
    );
}

const APIRoutesProps = struct {
    zig_code: []const u8,
};

fn APIRoutes(allocator: zx.Allocator, props: APIRoutesProps) zx.Component {
    return (
        <section id="api-routes" class="section" @allocator={allocator}>
            <h2>API Routes</h2>
            <p>ZX makes it easy to create APIs by adding <code>route.zig</code> files to your <code>app/pages/</code> directory. These files handle HTTP methods like GET, POST, and more.</p>
            <p>Create a <code>route.zig</code> file to handle API requests:</p>
            <CodeBlock code={props.zig_code} filename="route.zig" />
            <p>API routes have access to <code>zx.RouteContext</code>, which provides the request, response, and even WebSocket support. Learn more in the <a href="/reference#api-routes">API documentation</a>.</p>
        </section>
    );
}

const KVStorageProps = struct {
    kv_basic: []const u8,
    kv_typed: []const u8,
    kv_scoped: []const u8,
    enable_build: []const u8,
};

fn KVStorage(allocator: zx.Allocator, props: KVStorageProps) zx.Component {
    return (
        <section id="kv" class="section" @allocator={allocator}>
            <h2>Key-Value Storage</h2>
            <p>ZX includes a key-value store for persisting small pieces of data across requests and restarts. Access it through <code>zx.kv</code>.</p>

            <h3>Enabling</h3>
            <p>KV is disabled by default. Enable it in <code>build.zig</code> by passing <code>features</code> to your <code>ziex.init</code> call:</p>
            <CodeBlock code={props.enable_build} filename="build.zig" translate="no" />
            <p>Use <code>.kv = .{"{ .server = .enabled }"}</code> for server-side storage only, or <code>.kv = .enabled</code> to enable both server and client KV.</p>

            <p>Store and retrieve raw bytes:</p>
            <CodeBlock code={props.kv_basic} />
            <p><code>zx.kv.get</code> returns owned bytes (or <code>null</code>), so free them when you're done - or use the request arena as shown. List keys with a prefix using <code>zx.kv.list</code>.</p>

            <h3>Typed values</h3>
            <p>Use <code>zx.kv.putAs</code> and <code>zx.kv.as</code> to store and read typed Zig structs directly:</p>
            <CodeBlock code={props.kv_typed} />
            <p>If the stored value's type doesn't match, <code>zx.kv.as</code> returns <code>error.InvalidType</code>.</p>

            <h3>Scoped namespaces</h3>
            <p>Group keys into separate namespaces with <code>zx.kv.scoped</code>, passing an enum literal for the namespace name:</p>
            <CodeBlock code={props.kv_scoped} />
            <p>A scoped store exposes the same methods as the default one.</p>

            <div class="callout note">
                <strong>Storage backend:</strong>{" "}On native platforms, data is stored on the filesystem under <code>{"zig-out/data/kv/"}</code>{" "}in development and <code>{"<ZIEX_ROOT_DIR>/data/kv/"}</code>{" "}in production. On edge runtimes like Cloudflare Workers, ZX uses the platform's KV binding instead.
            </div>
        </section>
    );
}

const DatabaseProps = struct {
    db_basic: []const u8,
    db_typed: []const u8,
    db_transaction: []const u8,
    enable_build: []const u8,
};

fn Database(allocator: zx.Allocator, props: DatabaseProps) zx.Component {
    return (
        <section id="database" class="section" @allocator={allocator}>
            <h2>Database</h2>
            <p>ZX ships with a SQL database layer accessed through <code>zx.db</code>.</p>

            <h3>Enabling</h3>
            <p>The embedded SQLite database is disabled by default. Enable it in <code>build.zig</code> by passing <code>features</code> to your <code>ziex.init</code> call:</p>
            <CodeBlock code={props.enable_build} filename="build.zig" translate="no" />
            // TODO: uncoment when postgres is supported
            // <p>For Postgres, use <code>.postgres = .enabled</code> instead and access it through <code>zx.Db.Postgres</code>.</p>

            <p>Create tables and insert rows with <code>zx.db.run</code>:</p>
            <CodeBlock code={props.db_basic} />
            <p>Pass bindings as an inline literal: <code>.empty</code> for none, a tuple for positional <code>?1</code> placeholders, or a struct for named <code>$name</code> placeholders. Read a single row with <code>zx.db.get</code>, then pull columns with <code>row.text</code>, <code>row.int</code>, <code>row.float</code>, or <code>row.boolean</code>.</p>

            <h3>Reading typed rows</h3>
            <p>Map query results straight into Zig structs with <code>zx.db.rows</code> (or <code>zx.db.row</code> for a single result). Column names are matched to struct fields:</p>
            <CodeBlock code={props.db_typed} />

            <h3>Transactions</h3>
            <p>Run multiple statements atomically with <code>zx.db.transaction</code>. It takes a context value and a callback that receives that value plus a <code>zx.Db</code> handle:</p>
            <CodeBlock code={props.db_transaction} />
            <p>If the callback returns an error, the transaction rolls back. Use <code>zx.db.transactionWith</code> to pick an explicit mode (<code>.deferred</code>, <code>.immediate</code>, or <code>.exclusive</code>).</p>

            <div class="callout note">
                <strong>Backends:</strong>{" "}ZX uses SQLite on native platforms and Cloudflare D1 on Workers. The same <code>zx.db</code>{" "}API works across both.
            </div>
        </section>
    );
}

fn Deployment(allocator: zx.Allocator) zx.Component {
    return (
        <section id="deployment" class="section" @allocator={allocator}>
            <h2>Deployment</h2>
            <p>ZX apps can be deployed in three ways: as a <strong>standalone</strong> binary on your own server, as a <strong>static</strong> site on a CDN, or to an <strong>edge</strong> runtime like Cloudflare Workers or Vercel.</p>

            <h3 id="deployment-standalone">Standalone</h3>
            <p>Compile your app to a single, self-contained binary with zero runtime dependencies. Build for production, then bundle the binary with its static assets:</p>
            <CodeBlock code="zig build -Doptimize=ReleaseSafe" />
            <CodeBlock code="zig build zx -- bundle" />
            <p>This creates a <code>bundle/</code> directory containing your binary and <code>static/</code> assets. Copy the whole directory to your server and run the binary.</p>

            <h4 id="deployment-docker">Docker</h4>
            <p>Scaffold a project with a ready-to-use Dockerfile using the <code>docker</code> template:</p>
            <CodeBlock code="zx init --template docker" />
            <p>It uses a two-stage Alpine build that compiles your app and ships only the final binary and assets. Build and run the image:</p>
            <CodeBlock code="docker build -t myapp ." />

            <h4 id="deployment-railway">Railway</h4>
            <p>Scaffold a Railway project with the <code>railway</code> template, or deploy the starter template in one click:</p>
            <CodeBlock code="zx init --template railway" />
            <p>The template includes a Dockerfile and Railway configuration. Build for production, bundle assets, and deploy:</p>
            <CodeBlock code="zig build -Doptimize=ReleaseSafe && zig build zx -- bundle" />
            <p>
                <a href=`https://railway.com/new/template?template={ziex_org_url}/template-railway` target="_blank" rel="noopener noreferrer">Deploy on Railway</a>{" "}
                - one-click deploy from the{" "}
                <a href=`{ziex_org_url}/template-railway` target="_blank" rel="noopener noreferrer">template-railway</a>{" "}
                repo.
            </p>

            <h4 id="deployment-render">Render</h4>
            <p>Scaffold a Render project with the <code>render</code> template, or deploy the starter template in one click:</p>
            <CodeBlock code="zx init --template render" />
            <p>The template ships a <code>render.yaml</code> blueprint that configures build and start commands automatically. Deploy from the Render dashboard or use the one-click button:</p>
            <p>
                <a href=`https://render.com/deploy?repo={ziex_org_url}/template-render` target="_blank" rel="noopener noreferrer">Deploy to Render</a>{" "}
                - one-click deploy from the{" "}
                <a href=`{ziex_org_url}/template-render` target="_blank" rel="noopener noreferrer">template-render</a>{" "}
                repo.
            </p>

            <h3 id="deployment-static">Static</h3>
            <p>For sites without per-request server logic, export every route to static HTML:</p>
            <CodeBlock code="zig build zx -- export" />
            <p>This crawls all routes and writes the output to a <code>dist/</code> directory, ready to upload to any static host like Netlify, GitHub Pages, or a CDN.</p>

            <h3 id="deployment-edge">Edge</h3>
            <p>Ziex compiles to WebAssembly (WASI), so it can be deployed to edge runtimes like Cloudflare Workers or Vercel.</p>

            <h4 id="deployment-cloudflare">Cloudflare</h4>
            <p>Scaffold a Cloudflare Workers project with the <code>cloudflare</code> template:</p>
            <CodeBlock code="zx init --template cloudflare" />
            <p>The template includes a <code>wrangler.jsonc</code> that builds your app to WASM with bindings for Cloudflare related services:</p>
            <CodeBlock code="npx wrangler deploy" />

            <h4 id="deployment-vercel">Vercel</h4>
            <p>Scaffold a Vercel project with the <code>vercel</code> template:</p>
            <CodeBlock code="zx init --template vercel" />
            <p>The template includes a <code>vercel.json</code> configured for Edge Functions (with an optional Node.js runtime). You can deploy with the Vercel CLI:</p>
            <CodeBlock code="vercel deploy" />

            <div class="callout note">
                <strong>Others:</strong>{" "}
                You can deploy to any other platforms as you wish as Ziex output can be standalone binary, static site or WASM.
            </div>
        </section>
    );
}

fn NextSteps(allocator: zx.Allocator) zx.Component {
    return (
        <section id="next-steps" class="section" @allocator={allocator}>
            <h2>Next Steps</h2>
            <p>You now know the basics of ZX! Here's what to explore next:</p>
            <div class="next-steps-grid">
                <a href="/reference" class="next-step-card">
                    <h3>Documentation</h3>
                    <p>Deep dive into all ZX features with detailed examples.</p>
                </a>
                <a href="/reference#cli" class="next-step-card">
                    <h3>CLI Reference</h3>
                    <p>Learn about the ZX command-line tools.</p>
                </a>
                <a href="/examples" class="next-step-card">
                    <h3>Examples</h3>
                    <p>Explore working code examples and patterns.</p>
                </a>
            </div>
        </section>
    );
}

fn layoutFiles(allocator: zx.Allocator, layout_code: []const u8, page_code: []const u8) []const File {
    const files = allocator.alloc(File, 2) catch unreachable;
    files[0] = .{ .filename = "layout.zx", .code = layout_code };
    files[1] = .{ .filename = "page.zx", .code = page_code };
    return files;
}

