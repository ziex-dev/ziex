pub fn Layout(ctx: zx.LayoutContext, children: zx.Component) zx.Component {
    const allocator = ctx.arena;

    return (
        <Sidebar @{allocator} categories={&categories} toc={&toc_links} tabs={&tabs} active_path="/learn">
            {children}
        </Sidebar>
    );
}

const tabs = [_]SidebarProps.Tab{
    .{ .label = "Learn", .href = "/learn", .active = true },
    .{ .label = "Reference", .href = "/reference", .active = false },
};

const categories = [_]SidebarProps.Category{
    .{
        .title = "GET STARTED",
        .sections = &[_]SidebarProps.Section{
            .{ .title = "Quick Start", .href = "/learn" },
            .{
                .title = "Installation",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/learn#installation", .text = "Install Ziex CLI" },
                    .{ .href = "/learn#create-project", .text = "Create a Project" },
                },
            },
            .{
                .title = "Editor Setup",
                .href = "/learn#editor-setup",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/learn#devtools", .text = "Browser DevTools" },
                },
            },
        },
    },
    .{
        .title = "LEARN ZIEX",
        .sections = &[_]SidebarProps.Section{
            .{
                .title = "Describing the UI",
