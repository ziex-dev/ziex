pub fn Layout(ctx: zx.LayoutContext, children: zx.Component) zx.Component {
    const allocator = ctx.arena;

    return (
        <Sidebar @{allocator} categories={&categories} toc={toc_links} tabs={&tabs} active_path="/learn">
            {children}
        </Sidebar>
    );
}

const tabs = [_]SidebarProps.Tab{
    .{ .label = "Learn", .href = "/learn", .active = true },
    .{ .label = "Reference", .href = "/reference", .active = false },
};

pub const categories = [_]SidebarProps.Category{
    .{
        .title = "Get Started",
        .sections = &[_]SidebarProps.Section{
            .{ .title = "Quick Start", .href = "/learn" },
            .{ .title = "Installation", .href = "/learn#installation" },
            .{ .title = "Create a Project", .href = "/learn#create-project" },
            .{ .title = "Project Structure", .href = "/learn#project-structure" },
            .{
                .title = "Developer Tools",
                .href = "/learn#devtools",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/learn#editor-setup", .text = "Editor Extensions" },
                    .{ .href = "/learn#language-server", .text = "Language Server" },
                    .{ .href = "/learn#browser-devtools", .text = "Browser DevTools" },
                },
            },
        },
    },
    .{
        .title = "Learn Ziex",
        .sections = &[_]SidebarProps.Section{
            .{
                .title = "Describing the UI",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/learn#creating-components", .text = "Creating Components" },
                    .{ .href = "/learn#writing-markup", .text = "Writing Markup" },
                    .{ .href = "/learn#fragments", .text = "Fragments" },
                    .{ .href = "/learn#displaying-data", .text = "Displaying Data" },
                    .{ .href = "/learn#dynamic-attributes", .text = "Dynamic Attributes" },
                    .{ .href = "/learn#passing-props", .text = "Passing Props" },
                    .{ .href = "/learn#children", .text = "Children Props" },
                },
            },
            .{
                .title = "Control Flow",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/learn#conditional-rendering", .text = "Conditional Rendering" },
                    .{ .href = "/learn#rendering-lists", .text = "Rendering Lists" },
                },
            },
            .{
                .title = "Interactivity",
                .href = "/learn#interactivity",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/learn#event-handlers", .text = "Event Handlers" },
                    .{ .href = "/learn#binding-state", .text = "Binding State" },
                    .{ .href = "/learn#form-actions", .text = "Form Actions" },
                    .{ .href = "/learn#server-actions", .text = "Server Actions", .tags = &.{experimental.label} },
                },
            },
            .{
                .title = "Routing",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/learn#pages-layouts", .text = "Pages" },
                    .{ .href = "/learn#dynamic-routes", .text = "Dynamic Routes" },
                    .{ .href = "/learn#layouts", .text = "Layouts" },
                    .{ .href = "/learn#page-context", .text = "Page Context" },
                    .{ .href = "/learn#api-routes", .text = "API Routes" },
                },
            },
            .{
                .title = "Data & Storage",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/learn#kv", .text = "Key-Value Storage" },
                    .{ .href = "/learn#database", .text = "Database" },
                },
            },
        },
    },
    .{
        .title = "Deployment",
        .sections = &[_]SidebarProps.Section{
            .{
                .title = "Standalone",
                .href = "/learn#deployment-standalone",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/learn#deployment-docker", .text = "Docker" },
                    .{ .href = "/learn#deployment-railway", .text = "Railway" },
                    .{ .href = "/learn#deployment-render", .text = "Render" },
                },
            },
            .{ .title = "Static", .href = "/learn#deployment-static" },
            .{
                .title = "Edge",
                .href = "/learn#deployment-edge",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/learn#deployment-cloudflare", .text = "Cloudflare" },
                    .{ .href = "/learn#deployment-vercel", .text = "Vercel" },
                    .{ .href = "/learn#deployment-prerender", .text = "Pre-rendering" },
                },
            },
            .{ .title = "Build Output", .href = "/learn#deployment-output" },
        },
    },
};

const toc_links = docs_nav.toc(&categories);

const Sidebar = @import("../components/sidebar.zx").Sidebar;
const SidebarProps = @import("../components/sidebar.zx").SidebarProps;
const docs_nav = @import("../components/docs_nav.zx");
const experimental = @import("../components/experimental.zx");

const zx = @import("zx");
