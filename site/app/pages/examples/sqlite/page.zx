pub fn Page(ctx: zx.PageContext) zx.Component {
    return (
        <main @allocator={ctx.arena} class="example-page">
            <header class="example-header">
                <h1>SQLite Studio</h1>
                <p>zx.Db.Sqlite running in a Web Worker, persisted to OPFS. Press Ctrl/⌘+Enter to run.</p>
            </header>
            <Studio @client />
        </main>
    );
}

const Worker = @import("worker.zig");
const repl = zx.worker(Worker);
const studio_ui = @import("../studio.zx");
const studio = @import("../studio_lib.zig");

var tables: *zx.State([]const []const u8) = undefined;
var filter: *zx.State([]const u8) = undefined;
var result: *zx.State(?Worker.Result) = undefined;
var lines: *zx.State(usize) = undefined;
var cursor: *zx.State([2]usize) = undefined;
var loaded = false;

pub fn Studio(ctx: *zx.ComponentContext) zx.Component {
    tables = ctx.state([]const []const u8, &.{});
    filter = ctx.state([]const u8, "");
    result = ctx.state(?Worker.Result, null);
    lines = ctx.state(usize, 1);
    cursor = ctx.state([2]usize, .{ 1, 1 });

    if (zx.platform.isClient() and !loaded) {
        loaded = true;
        _ = zx.client.setTimeout(&loadTables, .fromMilliseconds(0));
    }

    return (
        <div @allocator={ctx.allocator} class="studio">
            <aside class="studio-sidebar">
                <input class="studio-search" type="search" placeholder="Search..." oninput={onFilter} />
                <div class="studio-sidebar-bar">
                    <span>Tables</span>
                    <button class="studio-icon-button" title="Refresh" aria-label="Refresh" onclick={onRefresh}>↻</button>
                </div>
                <ul class="studio-tables">
                    {for (tables.get()) |name| (
                        <TableItem name={name} filter={filter.get()} />
                    )}
                </ul>
            </aside>

            <section class="studio-main">
                <div class="studio-tabs">
                    <span class="studio-tab">Query</span>
                </div>
                <div class="studio-editor">
                    <div class="studio-gutter" aria-hidden="true">
                        {for (0..lines.get()) |i| (<div>{i + 1}</div>)}
                    </div>
                    <textarea
                        id="sqlite-input"
                        spellcheck="false"
                        placeholder="SELECT * FROM users;"
                        onkeydown={onKeyDown}
                        oninput={onCursor}
                        onkeyup={onCursor}
                        onclick={onCursor}
                    ></textarea>
                </div>
                <div class="studio-toolbar">
                    <span>Ln {cursor.get()[0]} Col {cursor.get()[1]}</span>
                    <button class="studio-run" onclick={onRun}>▶ Run</button>
                </div>
                <studio_ui.ResultView result={result.get()} />
            </section>
        </div>
    );
}

fn TableItem(ctx: *zx.ComponentCtx(struct { name: []const u8, filter: []const u8 })) zx.Component {
    const name = ctx.props.name;
    const hidden = ctx.props.filter.len > 0 and !studio.containsIgnoreCase(name, ctx.props.filter);
    const value = name;
    return (
        <li @allocator={ctx.allocator} {hidden}>
            <button class="studio-table" {value} onclick={onOpenTable}>
                <span class="studio-table-icon">▦</span>{name}
            </button>
        </li>
    );
}

fn loadTables() void {
    const names = repl.tables(zx.allocator) catch |err| {
        zx.log.err("sqlite tables: {t}", .{err});
        return;
    };
    tables.set(names);
}

fn onRefresh(_: zx.client.Event) void {
    loadTables();
}

fn onFilter(e: zx.client.Event) void {
    filter.set(zx.allocator.dupe(u8, e.value() orelse "") catch return);
}

fn onOpenTable(e: zx.client.Event) void {
    const name = e.value() orelse return;
    const sql = std.fmt.allocPrint(zx.allocator, "SELECT * FROM \"{s}\" LIMIT 100;", .{name}) catch return;
    const input = editor() orelse return;
    input.ref.set("value", js.string(sql)) catch return;
    updateCursor();
    run(sql);
}

fn onKeyDown(e: zx.client.Event) void {
    const k = e.as(zx.client.events.KeyboardEvent, zx.allocator);
    if (!std.mem.eql(u8, k.key, "Enter") or !(k.ctrl_key or k.meta_key)) return;
    e.preventDefault();
    onRun(e);
}

fn onRun(_: zx.client.Event) void {
    const input = editor() orelse return;
    const sql = input.ref.getAlloc(js.String, zx.allocator, "value") catch return;
    run(sql);
}

fn onCursor(_: zx.client.Event) void {
    updateCursor();
}

fn run(raw: []const u8) void {
    const sql = std.mem.trim(u8, raw, " \t\r\n;");
    if (sql.len == 0) return;
    result.set(repl.exec(zx.allocator, sql) catch |err| .{ .err = @errorName(err) });
    loadTables();
}

fn updateCursor() void {
    const input = editor() orelse return;
    const text = input.ref.getAlloc(js.String, zx.allocator, "value") catch return;
    const pos: usize = @intFromFloat(input.ref.get(f64, "selectionStart") catch 0);
    const before = text[0..@min(pos, text.len)];
    const line_start = if (std.mem.lastIndexOfScalar(u8, before, '\n')) |i| i + 1 else 0;
    lines.set(std.mem.count(u8, text, "\n") + 1);
    cursor.set(.{ std.mem.count(u8, before, "\n") + 1, before.len - line_start + 1 });
}

fn editor() ?zx.client.Document.HTMLElement {
    if (!zx.platform.isClient()) return null;
    const document = zx.client.Document.init(zx.allocator);
    return document.getElementById("sqlite-input") catch null;
}

const js = zx.client.js;
const zx = @import("zx");
const std = @import("std");
