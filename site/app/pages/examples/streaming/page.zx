pub fn Page(ctx: zx.PageContext) zx.Component {
    return (
        <main @allocator={ctx.arena}>
            <h1>Streaming SSR</h1>
            <p>This shell is rendered immediately, and then more content is streamed in over time.</p>

            <section
                @async={.stream}
                @fallback={(<UserProfile user_id={0} />)}
                class="card user"
            >
                <UserProfile user_id={42} />
            </section>

            <section
                @async={.stream}
                @fallback={(<RecentPosts count={0} />)}
                class="card posts"
            >
                <RecentPosts count={3} />
            </section>

            <section
                @async={.stream}
                @fallback={(<SiteStats loading={true} />)}
                class="card stats"
            >
                <SiteStats loading={false} />
            </section>
        </main>
    );
}


fn UserProfile(allocator: zx.Allocator, props: struct { user_id: u32 }) zx.Component {
    if (props.user_id != 0) wait(700);

    const name = if (props.user_id == 0) "....." else "Ziguana";
    return (
        <div @{allocator}>
            <h2>User Profile</h2>
            <p>Name: {name}</p>
        </div>
    );
}

fn RecentPosts(allocator: zx.Allocator, props: struct { count: u32 }) zx.Component {
    if (props.count != 0) wait(1600);

    const title = if (props.count == 0) "Recent Posts (.....)" else "Recent Posts (3)";
    const post1 = if (props.count == 0) "....." else "Getting Started with Ziex Framework";

    return (
        <div @{allocator}>
            <h2>{title}</h2>
            <p>{post1}</p>
        </div>
    );
}

fn SiteStats(allocator: zx.Allocator, props: struct { loading: bool }) zx.Component {
    if (!props.loading) wait(500);

    const users = if (props.loading) "....." else "12,847";

    return (
        <div @{allocator}>
            <h2>Site Statistics</h2>
            <p>Total Users: {users}</p>
        </div>
    );
}

fn wait(duration_ms: u64) void {
    if (zx.platform.isWasm()) return sleep_ms(@intCast(duration_ms));

    std.Io.sleep(zx.Io.default(), .fromMilliseconds(@intCast(duration_ms)), .awake) catch {};
}
extern "__zx_sys" fn sleep_ms(ms: u32) void;


pub const options = zx.PageOptions{
    .rendering = .streamed,
};

const std = @import("std");
const zx = @import("zx");
