var progress: *zx.State(u32) = undefined;
var running: *zx.State(bool) = undefined;
var interval_id: ?u64 = null;
var action_id: u64 = 0;

pub fn Page(ctx: zx.PageContext) !zx.Component {
    return (
        <main @allocator={ctx.arena} class="demo-page">
            <ProgressDemo @client />
        </main>
    );
}

pub fn ProgressDemo(ctx: *zx.ComponentContext) zx.Component {
    progress = ctx.state(u32, 0);
    running = ctx.state(bool, false);

    return (
        <div @allocator={ctx.allocator}>
            <header class="demo-header">
                <h1>Progress Demo</h1>
                <p>Fetch progress from the server via WebAssembly.</p>
            </header>

            <div class="demo-panel timer-output">
                <div class="progress-track">
                    <div class="progress-fill" style=`width:{progress}%`></div>
                </div>
                <span class="timer-count">{progress}%</span>
            </div>

            <div class="demo-row demo-row-wrap">
                <button class="demo-button" onclick={start} disabled={interval_id != null}>
                    {if (interval_id != null) ("Running...") else ("Start")}
                </button>
                <button class="demo-button" onclick={stop} disabled={interval_id == null}>Stop</button>
                <button class="demo-button" onclick={reset}>Reset</button>
            </div>

            <p class="demo-muted">
                {if (progress.get() >= 100) ("Complete!") else if (running.get()) ("Loading...") else ("Random +5-25% per request")}
            </p>

            <style @escaping={.none}>{css}</style>
        </div>
    );
}

fn start(_: zx.client.Event) void {
    if (interval_id != null) return;
    progress.set(0);
    fetch();
    interval_id = zx.client.setInterval(&fetch, 1200);
}

fn stop(_: zx.client.Event) void {
    if (interval_id) |id| {
        zx.client.clearInterval(id);
        interval_id = null;
        running.set(false);
    }
}

fn reset(_: zx.client.Event) void {
    if (interval_id) |id| {
        zx.client.clearInterval(id);
        interval_id = null;
    }
    action_id = 1;
    fetch();
    progress.set(0);
    running.set(false);
}

fn fetch() void {
    running.set(true);
    _ = zx.fetch(.wasm(&onFetch), zx.allocator, zx.allocator.print("/examples/progress?actionId={d}", .{action_id}) catch "/examples/progress", .{ .method = .POST }) catch {};
}

fn onFetch(res: ?*zx.Fetch.Response, _: ?zx.Fetch.Error) void {
    running.set(false);
    if (res) |r| {
        defer r.deinit();
        if (r.json(struct { progress: u32, completed: bool })) |p| {
            progress.set(p.value.progress);
            if (p.value.completed) {
                if (interval_id) |id| zx.client.clearInterval(id);
                interval_id = null;
            }
        } else |_| {}
    }
}

const css =
    \\.progress-track {
    \\   flex: 1;
    \\   height: 8px;
    \\   background: var(--border-color);
    \\   border-radius: 999px;
    \\   overflow: hidden;
    \\}
    \\.progress-fill {
    \\  height: 100%;
    \\  background: var(--link-color);
    \\  border-radius: inherit;
    \\  transition: width 0.2s;
    \\}
    \\.timer-output {
    \\  display: flex;
    \\  align-items: center;
    \\  gap: 1rem;
    \\}
;

const zx = @import("zx");
const std = @import("std");
