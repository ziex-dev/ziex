// --- Learn: onclick ---
pub fn Onclick__Page(ctx: zx.PageContext) !zx.Component {
    return (<Learn__EventHandling @allocator={ctx.arena} @client />);
}
pub fn Learn__Interactivity(allocator: zx.Allocator) zx.Component {
    return (<Learn__EventHandling @{allocator} @client />);
}
pub fn Learn__EventHandling(allocator: zx.Allocator) zx.Component {
    return (
        <main @allocator={allocator}>
            <button onclick={Learn__handleClick}>Click me</button>
            <input oninput={Learn__handleInput} />
        </main>
    );
}

fn Learn__handleClick(_: zx.client.Event) void {
    zx.log.info("Clicked!", .{});
}

fn Learn__handleInput(event: zx.client.Event) void {
    const v = event.value() orelse "";
    zx.log.info("Input: {s}", .{v});
}

// --- Learn: onnull ---

// --- Reference Inline: attrs ---
pub fn unwrap__template_attrs() void {
    const count = 42;
    const name = "John";
    // ...
    _ = (
        <div class=`item-{count}` data-user=`user-{name}`>
            <a href=`/users/{name}/profile`>Profile</a>
        </div>
    );
    // Renders:
    //<div class="item-42" data-user="user-John">
    //  <a href="/users/John/profile">Profile</a>
    //</div>
}

// --- Reference Inline: expr string ---
pub fn unwrap__ref_expr_string() void {
    const name = "Alice";
    // ...
    _ = (<p>{name}</p>); // <p>Alice</p>
}

// --- Reference Inline: expr int ---
pub fn unwrap__ref_expr_int() void {
    const count: u32 = 42;
    // ...
    _ = (<p>{count}</p>); // <p>42</p>
}

// --- Reference Inline: expr float ---
pub fn unwrap__ref_expr_float() void {
    const price: f32 = 19.99;
    // ...
    _ = (<p>${price}</p>); // <p>$19.99</p>
}

// --- Reference Inline: expr bool ---
pub fn unwrap__ref_expr_bool() void {
    const active = true;
    // ...
    _ = (<p>{active}</p>); // <p>true</p>
}

// --- Reference Inline: expr enum ---
pub fn unwrap__ref_expr_enum() void {
    const Status = enum { pending, approved, rejected };
    const status = Status.approved;
    // ...
    _ = (<p>{status}</p>); // <p>approved</p>
}

// --- Reference Inline: expr optional ---
pub fn unwrap__ref_expr_optional() void {
    const maybe_name: ?[]const u8 = "Bob";
    // ...
    _ = (<p>{maybe_name}</p>); // <p>Bob</p>

    const no_name: ?[]const u8 = null;
    // ...
    _ = (<p>{no_name}</p>); // <p></p> (empty)
}

// --- Reference Inline: expr component ---
pub fn unwrap__ref_expr_component() void {
    const header = zx.Component{ .text = "Header" };
    // ...
    _ = (<div>{header}</div>); // Renders the Header component
}

// --- Reference Inline: expr component array ---
pub fn unwrap__ref_expr_component_array() void {
    const items: []const zx.Component = &.{ zx.Component{ .text = "A" }, zx.Component{ .text = "B" } };
    // ...
    _ = (<ul>{items}</ul>); // Renders both Item components
}

// --- Reference Inline: optional capture ---
pub fn unwrap__ref_optional_capture() void {
    const user_name: ?[]const u8 = "Alice";
    // ...
    _ = if (user_name) |name| (<p>Welcome, {name}!</p>);

    // With else branch:
    _ = if (user_name) |name| (<p>Hello, {name}</p>) else (<p>Guest</p>);

    // While with capture (iterator pattern):
    var maybe_item: ?[]const u8 = "item";
    _ = while (maybe_item) |item| : (maybe_item = null) (<li>{item}</li>);
}

// --- Reference Inline: error capture ---
pub fn unwrap__ref_error_capture() void {
    const parsed = std.fmt.parseInt(u32, "42", 10);

    // If with error capture:
    _ = if (parsed) |value| (<p>Value: {value}</p>) else |err| (<p>Error: {@errorName(err)}</p>);

    // While with error capture:
    var first = true;
    _ = while (parseOnceRefInline(&first)) |value| (<li>{value}</li>) else |err| (<p>Iteration ended: {@errorName(err)}</p>);
}

fn parseOnceRefInline(first: *bool) !u32 {
    if (first.*) {
        first.* = false;
        return 1;
    }
    return error.Done;
}

// --- Reference Inline: spread attrs ---
pub fn unwrap__ref_spread_attrs() void {
    const form_attrs = .{
        .class = "form-control",
        .@"data-validate" = "true",
    };
    const input_props = .{ .name = "email", .value = "test@example.com" };
    // ...
    _ = (
        <form {..form_attrs}>
            <input type="text" {..input_props} />
        </form>
    );
}

// --- Reference Inline: shorthand attrs ---
pub fn unwrap__ref_shorthand_attrs() void {
    const class = "btn-primary";
    const disabled = true;
    const @"data-id" = "123";
    _ = (<button {class} {disabled} {@"data-id"}>Click</button>);
    // Renders: <button class="btn-primary" disabled data-id="123">Click</button>
}

// --- Reference Inline: template attrs ---
pub fn unwrap__ref_template_attrs() void {
    const count = 42;
    const name = "John";
    // ...
    _ = (
        <div class=`item-{count}` data-user=`user-{name}`>
            <a href=`/users/{name}/profile`>Profile</a>
        </div>
    );
    // Renders:
    //<div class="item-42" data-user="user-John">
    //  <a href="/users/John/profile">Profile</a>
    //</div>
}

// --- Reference Inline: component context ---
pub fn RefInlineNoProps__Container(ctx: *zx.ComponentContext) zx.Component {
    return (
        <div @allocator={ctx.allocator}>
            {ctx.children}
        </div>
    );
}

// --- Reference Inline: component ctx props ---
pub const RefInline__CardProps = struct { title: []const u8 };
pub fn RefInline__Card(ctx: *zx.ComponentCtx(RefInline__CardProps)) zx.Component {
    return (
        <article @allocator={ctx.allocator}>
            <h2>{ctx.props.title}</h2>
            {ctx.children}
        </article>
    );
}

// --- Reference Inline: multiline strings ---
pub fn unwrap__ref_multiline_strings() void {
    // Multiline strings use Zig's \\ syntax:
    _ = (
        <pre>
            {
            \\const x = 1;
            \\const y = 2;
            \\const sum = x + y;
        }
        </pre>
    );
}

// --- Reference Inline: comments ---
pub fn unwrap__ref_comments() void {
    // Single-line comments are supported in ZX:
    _ = (
        <div>
            // This is a comment
            <p>Visible content</p>
            // Another comment
        </div>
    );
}

// --- Reference Inline: route ctx ---
pub fn RefInline__GET(ctx: zx.RouteContext) !void {
    _ = ctx.request; // Request details
    _ = ctx.response; // Set headers, body, json, etc.
    _ = ctx.socket; // WebSocket upgrade and pub/sub
    _ = ctx.arena; // Request-scoped allocator
}

// --- Reference Inline: socket ctx ---
pub fn RefInline__Socket(ctx: zx.SocketContext) !void {
    _ = ctx.socket; // WebSocket interface
    _ = ctx.message; // Received message data
    _ = ctx.data; // Custom data from upgrade
    _ = ctx.arena; // Message-scoped allocator
}

// --- Reference Inline: component caching basic ---
pub fn unwrap__ref_component_caching_basic() void {
    // Cache for 10 seconds
    _ = (<header @caching="10s" />);

    // Cache for 5 minutes
    _ = (<aside @caching="5m" />);

    // Cache for 1 hour
    _ = (<footer @caching="1h" />);

    // Cache for 1 day
    _ = (<section @caching="1d" />);
}

// --- Reference Inline: component caching key ---
pub fn unwrap__ref_component_caching_key() void {
    // Cache with a custom key for manual invalidation
    _ = (<section @caching="10m:user-profile" />);

    // Cache navigation with key
    _ = (<nav @caching="1h:main-nav" />);
}

// --- Reference Inline: page caching ---
pub fn RefPageCaching__Page(ctx: zx.PageContext) zx.Component {
    return (
        <div @allocator={ctx.arena}>
            <h1>Cached Page</h1>
            <p>This page is cached for 5 minutes.</p>
        </div>
    );
}

// Enable page-level caching
pub const RefPageCaching__options = zx.PageOptions{
    .caching = .{ .ttl = .fromSeconds(300) }, // 5 minutes
};

// --- Reference Inline: layout caching ---
pub fn Ref__Layout(ctx: zx.LayoutContext, children: zx.Component) zx.Component {
    return (
        <html @allocator={ctx.arena}>
            <body>
                {children}
            </body>
        </html>
    );
}

// Cache the entire layout for 1 hour
pub const RefLayout__options = zx.LayoutOptions{
    .caching = .{ .ttl = .fromSeconds(3600) },
};

// --- Reference Inline: cache invalidation ---
pub fn unwrap__ref_cache_invalidation() void {
    // Delete a specific cache entry by key
    _ = zx.cache.delete("cmp:user-profile") catch false;

    // Delete all entries matching a prefix
    // Useful for invalidating related content
    _ = zx.cache.deletePrefix("cmp:user") catch 0;
}

// --- Learn: state management ---
pub fn State__Page(ctx: zx.PageContext) !zx.Component {
    return (<Learn__StatePanel @allocator={ctx.arena} @client />);
}
pub fn Learn__StateDemo(allocator: zx.Allocator) zx.Component {
    return (<Learn__StatePanel @allocator={allocator} @client />);
}

pub fn Learn__StatePanel(ctx: *zx.ComponentCtx(void)) zx.Component {
    const count = ctx.state(i32, 0);
    const title = ctx.state([]const u8, "Hello");
    return (
        <div @allocator={ctx.allocator}>
            <h1>App State: {title.get()}</h1>
            <p>Count: {count.get()}</p>
            <button onclick={count.bind(Learn__incrementCount)}>Increment Count</button>
        </div>
    );
}

fn Learn__incrementCount(value: i32) i32 {
    return value + 1;
}

// --- Learn: api route ---
pub fn Learn__GET(ctx: zx.RouteContext) !void {
    try ctx.response.json(.{ .message = "Hello World!" }, .{});
}

// --- Learn: enable kv ---
pub fn Learn__enableKvInit(b: *std.Build, app_exe: *std.Build.Step.Compile) !void {
    _ = try ziex.init(b, app_exe, .{
        .app = .{
            .features = .{
                .kv = .enabled,
            },
        },
    });
}

// --- Learn: enable db ---
pub fn Learn__enableDbInit(b: *std.Build, app_exe: *std.Build.Step.Compile) !void {
    _ = try ziex.init(b, app_exe, .{
        .app = .{
            .features = .{
                .sqlite = .enabled,
            },
        },
    });
}

// --- Learn: enable cache ---
pub fn Learn__enableCacheInit(b: *std.Build, app_exe: *std.Build.Step.Compile) !void {
    _ = try ziex.init(b, app_exe, .{
        .app = .{
            .features = .{
                .cache = .enabled,
            },
        },
    });
}

// --- Learn: kv basic ---
pub fn Learn__KvBasic(ctx: zx.PageContext) !zx.Component {
    try zx.kv.put("greeting", "hello from kv", .{});
    const value = try zx.kv.get(ctx.arena, "greeting");
    try zx.kv.delete("greeting");

    return (
        <main @allocator={ctx.arena}>
            <p>Stored value: {value orelse "not found"}</p>
        </main>
    );
}

// --- Learn: kv typed ---
pub fn Learn__KvTyped(ctx: zx.PageContext) !zx.Component {
    const User = struct {
        id: u32,
        name: []const u8,
        active: bool,
    };

    try zx.kv.putAs("user:123", User{
        .id = 123,
        .name = "alice",
        .active = true,
    }, .{});

    const user = try zx.kv.as(ctx.arena, "user:123", User);

    return (
        <main @allocator={ctx.arena}>
            {if (user) |u| (
                <p>User: {u.name} (#{u.id})</p>
            ) else (
                <p>Not found</p>
            )}
        </main>
    );
}

// --- Learn: kv scoped ---
pub fn Learn__KvScoped(ctx: zx.PageContext) !zx.Component {
    const sessions = zx.kv.scoped(.sessions);
    try sessions.put("abc123", "token-xyz", .{});
    const token = try sessions.get(ctx.arena, "abc123");

    return (
        <main @allocator={ctx.arena}>
            <p>Session token: {token orelse "none"}</p>
        </main>
    );
}

// --- Learn: db basic ---
pub fn Learn__DbBasic(ctx: zx.PageContext) !zx.Component {
    _ = try zx.db.run(
        \\CREATE TABLE IF NOT EXISTS posts (
        \\  id INTEGER PRIMARY KEY,
        \\  title TEXT NOT NULL
        \\)
    , .empty);

    _ = try zx.db.run("INSERT INTO posts (title) VALUES (?1)", .{"Hello World"});

    const row = try zx.db.get(ctx.arena, "SELECT title FROM posts ORDER BY id DESC LIMIT 1", .{});

    return (
        <main @allocator={ctx.arena}>
            <p>Latest post: {if (row) |r| r.text("title") else "none"}</p>
        </main>
    );
}

// --- Learn: db typed ---
pub fn Learn__DbTyped(ctx: zx.PageContext) !zx.Component {
    const Post = struct {
        id: i64,
        title: []const u8,
    };

    _ = try zx.db.run(
        \\CREATE TABLE IF NOT EXISTS blog_posts (
        \\  id INTEGER PRIMARY KEY,
        \\  title TEXT NOT NULL
        \\)
    , .empty);

    _ = try zx.db.run("INSERT INTO blog_posts (title) VALUES (?1)", .{"ZX Guide"});

    const posts = try zx.db.rows(ctx.arena, Post, "SELECT id, title FROM blog_posts", .{});

    return (
        <main @allocator={ctx.arena}>
            {for (posts) |post| (
                <p>{post.title} (#{post.id})</p>
            )}
        </main>
    );
}

// --- Learn: db transaction ---
pub fn Learn__DbTransaction(ctx: zx.PageContext) !zx.Component {
    const Account = struct { id: i64, balance: i64 };

    _ = try zx.db.run(
        \\CREATE TABLE IF NOT EXISTS accounts (
        \\  id INTEGER PRIMARY KEY,
        \\  balance INTEGER NOT NULL
        \\)
    , .empty);
    _ = try zx.db.run("INSERT OR REPLACE INTO accounts (id, balance) VALUES (1, 100), (2, 100)", .empty);

    try zx.db.transaction({}, transfer);

    const accounts = try zx.db.rows(ctx.arena, Account, "SELECT id, balance FROM accounts ORDER BY id", .{});

    return (
        <main @allocator={ctx.arena}>
            {for (accounts) |account| (
                <p>Account #{account.id}: {account.balance}</p>
            )}
        </main>
    );
}

fn transfer(_: void, db: zx.Db) !void {
    _ = try db.run("UPDATE accounts SET balance = balance - 10 WHERE id = ?1", .{1});
    _ = try db.run("UPDATE accounts SET balance = balance + 10 WHERE id = ?1", .{2});
}

// --- Learn: template attrs ---
pub fn unwrap__learn_template_attrs() void {
    const id = 42;
    // ...
    _ = (<a href=`/users/{id}/profile`>Profile</a>);
}

// --- Learn: spread attrs ---
pub fn unwrap__learn_spread_attrs() void {
    const attrs = .{ .class = "btn", .disabled = true };
    // ...
    _ = (<button {..attrs}>Click</button>);
}

// --- Learn: client action ---
pub fn ContactForm(ctx: *zx.ComponentCtx(void)) zx.Component {
    return (
        <form @allocator={ctx.allocator} action={ctx.bind(ContactForm__onSubmit)}>
            <input type="text" name="message" />
            <button type="submit">Send</button>
        </form>
    );
}

fn ContactForm__onSubmit(a: *zx.client.Action.Stateful) void {
    const data = a.data(struct { message: []const u8 });
    zx.log.info("message: {s}", .{data.message});
}

// --- Learn: server action ---
pub fn LoginForm(allocator: zx.Allocator) zx.Component {
    return (
        <form @allocator={allocator} action={onLogin}>
            <input type="text" name="username" />
            <button type="submit">Log in</button>
        </form>
    );
}

fn onLogin(a: zx.server.Action) void {
    const data = a.data(struct { username: []const u8 });
    zx.log.info("username: {s}", .{data.username});
}

// --- Reference Inline: csr simple handler ---
fn handleInput(event: zx.client.Event) void {
    const value = event.value() orelse "";
    zx.log.info("Input: {s}", .{value});
}
// Attach: oninput={handleInput}

// --- Reference Inline: csr stateful handler ---
pub fn CsrStateful__Counter(ctx: *zx.ComponentCtx(void)) zx.Component {
    const count = ctx.state(i32, 0);
    return (
        <div @allocator={ctx.allocator}>
            <button onclick={ctx.bind(CsrStateful__increment)}>{count}</button>
        </div>
    );
}
fn CsrStateful__increment(e: *zx.client.Event.Stateful) void {
    const count = e.state(i32); // same order as ctx.state()
    count.set(count.get() + 1);
}

// --- Reference Inline: csr state bind ---
pub fn CsrStateBind__Counter(ctx: *zx.ComponentCtx(void)) zx.Component {
    const count = ctx.state(i32, 0);
    return (
        <div @allocator={ctx.allocator}>
            <button onclick={count.bind(CsrStateBind__increment)}>{count}</button>
        </div>
    );
}
fn CsrStateBind__increment(value: i32) i32 {
    return value + 1;
}

// --- Imports ---
/// Docs-site preview helper (not part of the CSR playground section extract).
pub fn Client(allocator: zx.Allocator) zx.Component {
    return (<Counter @{allocator} @client />);
}

pub fn RenderTest(ctx: zx.PageContext) !zx.Component {
    if (builtin.optimize != .debug) return .none;

    const allocator = ctx.arena;

    var conn = zx.Http.Conn.init(allocator);
    defer conn.deinit();
    conn.search = ctx.request.search;
    const request = conn.request(ctx.request.method, ctx.request.pathname, ctx.request.url);
    const response = conn.response();

    const layout_ctx = zx.LayoutContext{
        .request = request,
        .response = response,
        .allocator = allocator,
        .arena = allocator,
        .io = ctx.io,
    };
    const page_ctx = zx.PageContext{
        .request = request,
        .response = response,
        .allocator = allocator,
        .arena = allocator,
        .io = ctx.io,
    };

    const route_ctx = zx.RouteContext{
        .request = request,
        .response = response,
        .socket = .{},
        .allocator = allocator,
        .arena = allocator,
        .io = ctx.io,
    };
    const socket_ctx = zx.SocketContext{
        .socket = .{},
        .message = "Hello",
        .data = {},
        .allocator = allocator,
        .message_type = .text,
        .arena = allocator,
        .io = ctx.io,
    };

    _ = try RefInline__GET(route_ctx);
    _ = try RefInline__Socket(socket_ctx);
    _ = try POST(route_ctx);
    _ = try Api__GET(route_ctx);
    _ = try GET(route_ctx);
    _ = try Learn__GET(route_ctx);
    _ = try Learn__KvBasic(page_ctx);
    _ = try Learn__KvTyped(page_ctx);
    _ = try Learn__KvScoped(page_ctx);
    _ = try Learn__DbBasic(page_ctx);
    _ = try Learn__DbTyped(page_ctx);
    
    if (!builtin.target.cpu.arch.isWasm()) 
        _ = try Learn__DbTransaction(page_ctx);
    

    // TODO: inject proper "ziex" build module to test these
    _ = try Learn__enableKvInit(undefined, undefined);
    _ = try Learn__enableDbInit(undefined, undefined);
    _ = try Learn__enableCacheInit(undefined, undefined);
    _ = Learn__build;

    _ = RefPageCaching__Page(page_ctx);
    _ = Ref__Layout(layout_ctx, .none);
    _ = RefLayout__options;
    _ = CachingPage__options;

    // Keep unwrap snippets linked for compile-time validation (they construct
    // orphaned JSX without an allocator, so do not execute them at runtime).
    _ = unwrap__learn_template_attrs;
    _ = unwrap__learn_spread_attrs;

    return (
        <div @{allocator} style="display: none">
            <ControlIf is_admin={true} />
            <ControlIfOptional />
            <ControlIfError />
            <ControlSwitch role={Role.member} />
            <ControlFor items={&.{"One", "Two", "Three"}} />
            <ControlWhile />
            <ControlWhileOptional />
            <ControlWhileError />
            <CacheComponent />
            <Fragment />
            <SpreadProps />
            <DynamicAttr />
            <Client />
            <RefInlineNoProps__Container />
            <RefInline__Card title="Hello" />
            <ContactForm />
            <LoginForm />
            <CsrStateful__Counter />
            <CsrStateBind__Counter />
            <input oninput={handleInput} />
        </div>
    );
}

const ziex = struct {
    pub fn init(b: *std.Build, app_exe: *std.Build.Step.Compile, options: InitOptions) !void {
        _ = b;
        _ = app_exe;
        _ = options;
    }
};

const builtin = @import("builtin");
const zx = @import("zx");
const InitOptions = @import("initoptions");
const std = @import("std");
