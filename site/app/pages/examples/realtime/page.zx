pub fn Page(ctx: zx.PageContext) zx.Component {
    var chat_username = ctx.request.cookies.get("username") orelse "";
    const set_username = ctx.request.query.get("username") orelse "";
    const leave_username = ctx.request.query.get("leave") orelse "";
    if (set_username.len > 0) {
        ctx.response.cookies.set("username", set_username, .{});
        chat_username = set_username;
        ctx.response.redirect("/examples/realtime", null);
    }
    if (leave_username.len > 0) {
        ctx.response.cookies.delete("username", .{});
        chat_username = "";
    }

    return (
        <main @allocator={ctx.arena} class="demo-page">
            {if (chat_username.len > 0) (<ChatRoom username={chat_username} @client />) else (<JoinScreen />)}
            <style @escaping={.none}>{@embedFile("style.css")}</style>
        </main>
    );
}

fn JoinScreen(allocator: zx.Allocator) zx.Component {
    return (
        <div @allocator={allocator}>
            <header class="demo-header">
                <h1>Realtime chat</h1>
                <p>Choose a name and join a small room powered by Ziex WebSockets.</p>
            </header>
            <form class="demo-row demo-row-mobile-stack">
                <input type="text" class="demo-input" name="username" placeholder="Enter your name" required />
                <button type="submit" class="demo-button demo-button-primary">Join Chat</button>
            </form>
        </div>
    );
}

pub fn ChatRoom(ctx: *zx.ComponentCtx(struct { username: []const u8 })) zx.Component {
    const msgs_state = ctx.state(MessageList, .empty);
    messages = msgs_state;

    const connected = ws != null;
    const status_class = if (connected) "status-online" else "status-offline";
    const msgs = msgs_state.get();

    if (ws == null) {
        joinChat(ctx.props.username);
    }

    return (
        <section @allocator={ctx.allocator} class="demo-panel chat-room">
            <div class="chat-header">
                <div>
                    <h1>Chat room</h1>
                </div>
                <div class="chat-user-info">
                    <span class={status_class}></span>
                    <span class="chat-username">{ctx.props.username}</span>
                    <form class="chat-leave-form">
                        <button name="leave" class="demo-button chat-leave-btn" value={ctx.props.username}>Leave</button>
                    </form>
                </div>
            </div>

            <div class="chat-messages">
                {for (msgs.items) |msg| (<MessageItem key={msg.text} username={msg.username} text={msg.text} is_system={msg.is_system} />)}
            </div>

            <form class="demo-row chat-input" onsubmit={sendMessage}>
                <input type="text" class="demo-input" id="message-input" placeholder="Write a message" />
                <button class="demo-button demo-button-primary" onclick={sendMessage}>Send</button>
            </form>
        </section>
    );
}

const MessageItemProps = struct { username: []const u8, text: []const u8, is_system: bool };
fn MessageItem(allocator: zx.Allocator, props: MessageItemProps) zx.Component {
    if (props.is_system) {
        return (<div @allocator={allocator} class="chat-msg chat-msg-system">{props.text}</div>);
    }

    const is_self = std.mem.eql(u8, props.username, current_username);
    const msg_class = if (is_self) "chat-msg chat-msg-self" else "chat-msg chat-msg-other";

    return (
        <div @allocator={allocator} class={msg_class}>
            <span class="chat-msg-name">{props.username}</span>
            <p class="chat-msg-text">{props.text}</p>
        </div>
    );
}

const Message = struct { username: []const u8, text: []const u8, is_system: bool };
const MessageList = std.ArrayList(Message);

var messages: ?*zx.State(MessageList) = null;
var ws: ?zx.WebSocket = null;
var current_username: []const u8 = "";

fn joinChat(username: []const u8) void {
    if (zx.platform.role != .client) return;

    std.log.info("joinChat: {s}", .{username});
    current_username = zx.allocator.dupe(u8, username) catch return;
    ws = zx.WebSocket.init(zx.allocator, "/examples/realtime/ws", .{}) catch return;

    if (ws) |*w| {
        w.onopen = &onWsOpen;
        w.onmessage = &onWsMessage;
        w.onclose = &onWsClose;
        w.onerror = &onWsError;
        w.connect() catch {};
    }

    if (messages) |msgs_state| {
        msgs_state.set(msgs_state.get());
    }
}

fn sendMessage(e: zx.client.Event) void {
    if (zx.platform.role != .client) return;
    e.preventDefault();

    const document = zx.client.Document.init(zx.allocator);
    const input = document.getElementById("message-input") catch return;
    const text = input.ref.getAlloc(zx.client.js.String, zx.allocator, "value") catch return;

    std.log.info("sendMessage: {s}", .{text});
    if (text.len == 0) return;

    if (ws) |*w| {
        if (w.isConnected()) {
            w.send(.{ .text = text }) catch {};
            input.ref.set("value", zx.client.js.string("")) catch {};
        }
    }
}

fn onWsOpen(_: *zx.WebSocket) void {}

fn onWsMessage(_: *zx.WebSocket, event: zx.WebSocket.MessageEvent) void {
    if (zx.platform.role != .client) return;

    const data = event.text() orelse return;
    const is_system = std.mem.startsWith(u8, data, "system:");

    var username: []const u8 = "";
    var text: []const u8 = data;

    if (std.mem.indexOf(u8, data, ": ")) |colon_idx| {
        username = zx.allocator.dupe(u8, data[0..colon_idx]) catch return;
        text = zx.allocator.dupe(u8, data[colon_idx + 2 ..]) catch return;
    } else {
        text = zx.allocator.dupe(u8, data) catch return;
    }

    if (messages) |msgs_state| {
        var msgs = msgs_state.get();
        msgs.insert(zx.allocator, 0, .{
            .username = username,
            .text = text,
            .is_system = is_system,
        }) catch return;
        msgs_state.set(msgs);
    }
}

fn onWsClose(_: *zx.WebSocket, _: zx.WebSocket.CloseEvent) void {
    if (zx.platform.role != .client) return;

    if (messages) |msgs_state| {
        var msgs = msgs_state.get();
        msgs.insert(zx.allocator, 0, .{
            .username = "",
            .text = "Disconnected from server",
            .is_system = true,
        }) catch {};
        msgs_state.set(msgs);
    }
}

fn onWsError(_: *zx.WebSocket, _: zx.WebSocket.ErrorEvent) void {
    if (zx.platform.role != .client) return;

    if (messages) |msgs_state| {
        var msgs = msgs_state.get();
        msgs.insert(zx.allocator, 0, .{
            .username = "",
            .text = "Connection error",
            .is_system = true,
        }) catch {};
        msgs_state.set(msgs);
    }
}

const zx = @import("zx");
const std = @import("std");
