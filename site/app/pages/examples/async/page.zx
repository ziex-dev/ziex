pub fn Page(ctx: zx.PageContext) !zx.Component {
    return (
        <main @allocator={ctx.arena} class="example-page">
            <header class="example-header">
                <h1>Async APIs</h1>
                <p>Observe timeout, interval, and fetch callbacks update component state.</p>
            </header>
            <AsyncDemo @client />
        </main>
    );
}

var interval_count: *zx.State(u32) = undefined;
var status: *zx.State([]const u8) = undefined;
var interval_id: ?u64 = null;

pub fn AsyncDemo(ctx: *zx.ComponentContext) zx.Component {
    interval_count = ctx.state(u32, 0);
    status = ctx.state([]const u8, "Ready");

    return (
        <section @allocator={ctx.allocator}>
            <div class="example-actions">
                <button onclick={startTimeout}>setTimeout (2s)</button>
                <button onclick={toggleInterval}>
                    {if (interval_id != null) "Stop Interval" else "Start Interval (1s)"}
                </button>
                <button onclick={doFetch}>Fetch API</button>
                <button onclick={reset}>Reset</button>
            </div>
            <p>Status: <strong>{status}</strong></p>
            <p>Interval ticks: <strong>{interval_count}</strong></p>
        </section>
    );
}

fn startTimeout(_: zx.client.Event) void {
    status.set("Waiting for timeout");
    std.log.info("setTimeout started (2 seconds)...", .{});
    _ = zx.client.setTimeout(&onTimeoutFired, 2000);
}

fn toggleInterval(_: zx.client.Event) void {
    if (interval_id) |id| {
        zx.client.clearInterval(id);
        interval_id = null;
        status.set("Interval stopped");
        std.log.info("Interval stopped", .{});
    } else {
        interval_count.set(0);
        interval_id = zx.client.setInterval(&onIntervalTick, 1000);
        status.set("Interval running");
        std.log.info("Interval started (every 1 second)", .{});
    }
}

fn onIntervalTick() void {
    interval_count.set(interval_count.get() + 1);
}

fn onTimeoutFired() void {
    status.set("Timeout complete");
    std.log.info("setTimeout fired after 2 seconds!", .{});
}

fn onFetchComplete(_: void, result: zx.http.Client.Error!zx.http.Client.Result) void {
    const res = result catch |err| {
        status.set("Fetch failed");
        std.log.err("Fetch error: {s}", .{@errorName(err)});
        return;
    };
    status.set("Fetch complete");
    std.log.info("Fetch completed! Response: {s}", .{res.body});
}

fn doFetch(_: zx.client.Event) void {
    status.set("Fetching");
    std.log.debug("Starting fetch request (client-side)...", .{});

    var client: zx.http.Client = .{ .io = zx.Io.default(), .allocator = zx.allocator };
    client.fetchThen(.{ .url = "/examples/api-route" }, {}, onFetchComplete);

    std.log.info("Fetch initiated (async)", .{});
}

fn reset(_: zx.client.Event) void {
    if (interval_id) |id| zx.client.clearInterval(id);
    interval_id = null;
    interval_count.set(0);
    status.set("Ready");
}

const zx = @import("zx");
const std = @import("std");
