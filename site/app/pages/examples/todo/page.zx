pub fn Page(ctx: zx.PageContext) zx.Component {
    return (
        <main @allocator={ctx.arena} class="demo-page">
            <TodoApp @client />
        </main>
    );
}

const Todo = struct { id: u32, text: []const u8, completed: bool };
const TodoList = std.ArrayList(Todo);

pub fn TodoApp(ctx: *zx.ComponentCtx(void)) !zx.Component {
    const todos_state = ctx.state(TodoList, blk: {
        var list = TodoList.empty;
        try list.appendSlice(ctx.allocator, &initial_todos);
        break :blk list;
    });
    _ = ctx.state(u32, 4);

    const todos_list = todos_state.get();

    return (
        <div @allocator={ctx.allocator} class="todo-app">
            <header class="demo-header">
                <h1>Todo app</h1>
                <p>A small interactive list using zx.State, zx.client.Event and zx.client.js.</p>
            </header>

            <form class="demo-row demo-row-mobile-stack todo-form" onsubmit={ctx.bind(&addTodo)}>
                <input type="text" class="demo-input" id="todo-input" placeholder="Add a new todo" required />
                <button class="demo-button demo-button-primary" type="submit">Add</button>
            </form>

            <div class="demo-row todo-stats">
                <span>{todos_list.items.len} total · {countCompleted(todos_list)} done · {todos_list.items.len - countCompleted(todos_list)} left</span>
                <button class="demo-button" onclick={ctx.bind(&clearTodos)}>Clear All</button>
            </div>

            <ul class="todo-list" style="max-width: 100%;">
                {for (todos_list.items) |todo| (
                    <TodoItem 
                        id={todo.id} 
                        text={todo.text} 
                        completed={todo.completed} 
                        onToggle={ctx.bind(&toggleTodo)}
                        onDelete={ctx.bind(&deleteTodo)}
                    />
                )}
            </ul>
        </div>
    );
}

fn TodoItem(ctx: *zx.ComponentCtx(struct { 
    id: u32, 
    text: []const u8, 
    completed: bool,
    onToggle: zx.EventHandler,
    onDelete: zx.EventHandler
})) zx.Component {
    const class = if (ctx.props.completed) "todo-item todo-item-completed" else "todo-item";
    const key = ctx.props.id;
    const value = ctx.props.id;

    return (
        <li @allocator={ctx.allocator} {class} {key}>
            <button class="todo-checkbox" aria-label="Toggle todo" {value} onclick={ctx.props.onToggle}>
                {if (ctx.props.completed) "✓" else ""}
            </button>
            <span> {ctx.props.text} </span>
            <button class="demo-icon-button todo-delete-btn" {value} onclick={ctx.props.onDelete}>×</button>
        </li>
    );
}

const initial_todos = [_]Todo{
    .{ .id = 1, .text = "Build a fast web app with Ziex", .completed = true },
    .{ .id = 2, .text = "Implement server-side rendering", .completed = true },
    .{ .id = 3, .text = "Implement client-side rendering", .completed = false },
};

fn addTodo(e: *zx.client.Event.Stateful) void {
    e.preventDefault();
    if (!zx.platform.isClient()) return;

    const todos_state = e.state(TodoList);
    const id_state = e.state(u32);

    const document = zx.client.Document.init(zx.allocator);
    const input = document.getElementById("todo-input") catch return;
    const text = input.ref.getAlloc(js.String, zx.allocator, "value") catch return;
    if (text.len == 0) return;

    const id = id_state.get();
    id_state.set(id + 1);

    var list = todos_state.get();
    list.append(zx.allocator, .{ .id = id, .text = text, .completed = false }) catch return;
    todos_state.set(list);

    input.ref.set("value", js.string("")) catch return;
}

fn toggleTodo(e: *zx.client.Event.Stateful) void {
    if (!zx.platform.isClient()) return;
    const todos_state = e.state(TodoList);
    _ = e.state(u32); // skip next_id

    const event = e.getEvent();
    defer event.deinit();
    var id: ?u32 = null;
    if (event.getTarget()) |target| {
        defer target.deinit();
        if (target.getAlloc(js.String, zx.allocator, "value") catch null) |v| {
            id = std.fmt.parseInt(u32, v, 10) catch null;
        }
    }

    const list = todos_state.get();
    for (list.items) |*todo| {
        if (todo.id == id) {
            todo.completed = !todo.completed;
            break;
        }
    }
    todos_state.set(list);
}

fn clearTodos(e: *zx.client.Event.Stateful) void {
    const todos_state = e.state(TodoList);
    var list = todos_state.get();
    list.items.len = 0;
    todos_state.set(list);
}

fn deleteTodo(e: *zx.client.Event.Stateful) void {
    if (!zx.platform.isClient()) return;
    const todos_state = e.state(TodoList);
    _ = e.state(u32); // skip next_id

    const event = e.getEvent();
    defer event.deinit();
    var id: ?u32 = null;
    if (event.getTarget()) |target| {
        defer target.deinit();
        if (target.getAlloc(js.String, zx.allocator, "value") catch null) |v| {
            id = std.fmt.parseInt(u32, v, 10) catch null;
        }
    }

    var list = todos_state.get();
    for (list.items, 0..) |todo, i| {
        if (todo.id == id) {
            _ = list.orderedRemove(i);
            break;
        }
    }
    todos_state.set(list);
}

fn countCompleted(list: TodoList) u32 {
    var count: u32 = 0;
    for (list.items) |todo| {
        if (todo.completed) count += 1;
    }
    return count;
}

const js = zx.client.js;

const zx = @import("zx");
const std = @import("std");
