pub fn InstallCLI(allocator: zx.Allocator, props: struct { show_init: bool = false }) zx.Component {
    return (
        <div class="install-box" @allocator={allocator}>
            <div class="install-box-header">
                <input type="radio" id="tab-unix" name="install-platform" class="install-tab-radio" checked="true" aria-label="Linux or macOS installation" />
                <input type="radio" id="tab-windows" name="install-platform" class="install-tab-radio" aria-label="Windows installation" />
                {if (props.show_init) (<input type="radio" id="tab-node" name="install-platform" class="install-tab-radio" aria-label="Node.js installation" />)}
                {if (props.show_init) (<input type="radio" id="tab-manual" name="install-platform" class="install-tab-radio" aria-label="Manual installation" />)}
                <div class="install-tab-labels">
                    <label for="tab-unix" class="install-tab-label">Linux / macOS</label>
                    <label for="tab-windows" class="install-tab-label">Windows</label>
                    <span class="install-tab-separator" aria-hidden="true"></span>
                    {if (props.show_init) (<label for="tab-node" class="install-tab-label">Node.js</label>)}
                    {if (props.show_init) (<label for="tab-manual" class="install-tab-label">Manual</label>)}
                </div>
            </div>
            <div class="install-box-content" translate="no">
                <div class="install-tab-content" id="content-unix">
                    <div class="install-code">
                        <span class="install-prompt" aria-hidden="true">$ </span>
                        <span class="function">curl</span>
                        <span class="operator"> -fsSL </span>
                        <span class="string">{zx.info.homepage}/install</span>
                        <span class="operator"> | </span>
                        <span class="function">bash</span>
                    </div>
                    {if (props.show_init) (
                        <div class="install-code">
                            <span class="install-prompt" aria-hidden="true">$ </span>
                            <span class="function">zx</span>
                            <span class="operator"> init</span>
                        </div>
                    )}
                </div>
                <div class="install-tab-content" id="content-windows">
                    <div class="install-code">
                        <span class="install-prompt" aria-hidden="true">{"> "}</span>
                        <span class="function">powershell</span>
                        <span class="operator"> -c </span>
                        <span class="string">"irm {zx.info.homepage["https://".len..]}/install.ps1 | iex"</span>
                    </div>
                    {if (props.show_init) (
                        <div class="install-code">
                            <span class="install-prompt" aria-hidden="true">{"> "}</span>
                            <span class="function">zx</span>
                            <span class="operator"> init</span>
                        </div>
                    )}
                </div>
                {if (props.show_init) (
                    <div class="install-tab-content" id="content-node">
                        <div class="install-code">
                            <span class="install-prompt" aria-hidden="true">$ </span>
                            <span class="function">npm</span>
                            <span class="operator"> create </span>
                            <span class="variable">ziex</span>
                            <span class="comment" aria-hidden="true" style="user-select: none; -webkit-user-select: none;"> # or </span>
                        </div>
                        <div class="install-code">
                            <span class="install-prompt" aria-hidden="true">$ </span>
                            <span class="function">bun</span>
                            <span class="operator"> create </span>
                            <span class="variable">ziex</span>
                        </div>
                    </div>
                )}
                {if (props.show_init) (
                    <div class="install-tab-content" id="content-manual">
                        <div class="install-code install-code-multiline">
                            <div class="install-code">
                                <span class="install-prompt" aria-hidden="true">$ </span>
                                <span class="function">git</span>
                                <span class="operator"> clone </span>
                                <span class="variable">{ziex_org_url}/template-starter </span>
                                <span class="variable">my-app</span>
                            </div>
                            <div>
                                <span class="install-prompt" aria-hidden="true">$ </span>
                                <span class="function">cd</span>
                                <span class="operator"> </span>
                                <span class="variable"> my-app</span>
                                <span class="operator"> && </span>
                                <span class="function">zig</span>
                                <span class="operator"> build </span>
                                <span class="variable">dev</span>
                            </div>
                        </div>
                    </div>
                )}
            </div>
        </div>
    );
}

pub fn InstallZig(allocator: zx.Allocator) zx.Component {
    return (
        <div class="install-box" @allocator={allocator}>
            <div class="install-box-header">
                <input type="radio" id="tab-zig-mac" name="install-zig" class="install-tab-radio" checked="true" aria-label="Zig installation on macOS" />
                <input type="radio" id="tab-zig-win" name="install-zig" class="install-tab-radio" aria-label="Zig installation on Windows" />
                <input type="radio" id="tab-zig-other" name="install-zig" class="install-tab-radio" aria-label="Zig installation on other platforms" />
                <div class="install-tab-labels">
                    <label for="tab-zig-mac" class="install-tab-label">macOS</label>
                    <label for="tab-zig-win" class="install-tab-label">Windows</label>
                    <label for="tab-zig-other" class="install-tab-label">Other</label>
                </div>
            </div>
            <div class="install-box-content">
                <div class="install-tab-content" id="content-zig-mac">
                    <div class="install-code" translate="no">
                        <span class="install-prompt">$ </span>
                        <span class="function">brew</span>
                        <span class="operator"> install </span>
                        <span class="variable">zig</span>
                    </div>
                </div>
                <div class="install-tab-content" id="content-zig-win">
                    <div class="install-code" translate="no">
                        <span class="install-prompt">{"> "}</span>
                        <span class="function">winget</span>
                        <span class="operator"> install -e --id </span>
                        <span class="variable">zig.zig</span>
                    </div>
                </div>
                <div class="install-tab-content" id="content-zig-other">
                    <div class="install-other">
                        See the <a href="https://ziglang.org/learn/getting-started/" target="_blank" rel="noopener noreferrer">official Zig installation guide</a>.
                    </div>
                </div>
            </div>
        </div>
    );
}

const zx = @import("zx");
const ziex_org_url = zx.info.repository[0..(zx.info.repository.len - "/ziex".len)];
