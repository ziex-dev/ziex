
pub fn Version(allocator: zx.Allocator) !zx.Component {
    return (
        <LiveVersionBadge
            @{allocator}
            @caching="1h:ziex_version"
        />
    );
}

pub fn VersionMeta(allocator: zx.Allocator) zx.Component {
    const latest = latestRelease();
    const version_raw = if (latest) |r| r.version else zx.info.version;
    const zig_raw = if (latest) |r| r.minimum_zig_version else zx.info.minimum_zig_version;
    const version = displayVersion(allocator, version_raw);
    const zig_version = displayVersion(allocator, zig_raw);
    const version_url = if (latest) |_| releaseUrl(allocator, version_raw) else zx.info.repository;
    const others = versions.releases;
    const development = displayVersion(allocator, zx.info.version);
    const development_zig = displayVersion(allocator, zx.info.minimum_zig_version);

    return (
        <div @{allocator} class="hero-install-meta">
            <span class="hero-install-meta-trigger" tabindex="0">
                <a class="hero-install-meta-link" href={version_url} target="_blank" rel="noopener noreferrer">v{version}</a>
                <span class="hero-install-meta-sep" aria-hidden="true">·</span>
                <span class="hero-install-meta-zig">Zig {zig_version}</span>
                <div class="hero-install-meta-tooltip" role="tooltip">
                    <table class="hero-install-meta-table">
                        <thead>
                            <tr>
                                <th>Ziex</th>
                                <th>Zig</th>
                            </tr>
                        </thead>
                        <tbody>
                            {for (others) |release| (
                                <tr class=`is-{release.status}`>
                                    <td>
                                        <a href={releaseUrl(allocator, release.version)} target="_blank" rel="noopener noreferrer">v{displayVersion(allocator, release.version)}</a>
                                    </td>
                                    <td>{displayVersion(allocator, release.minimum_zig_version)}</td>
                                </tr>
                            )}
                            <tr class="is-development">
                                <td>
                                    <a href={zx.info.repository} target="_blank" rel="noopener noreferrer">v{development}</a>
                                </td>
                                <td>{development_zig}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </span>
        </div>
    );
}

fn latestRelease() ?Versions.Release {
    for (versions.releases) |release| {
        if (release.status == .latest) return release;
    }
    if (versions.releases.len > 0) return versions.releases[0];
    return null;
}

fn displayVersion(allocator: zx.Allocator, raw: []const u8) []const u8 {
    const text = if (raw.len > 0 and raw[0] == 'v') raw[1..] else raw;
    var parsed = std.SemanticVersion.parse(text) catch return text;
    parsed.build = null;
    return std.fmt.allocPrint(allocator, "{f}", .{parsed}) catch text;
}

fn releaseUrl(allocator: zx.Allocator, version: []const u8) []const u8 {
    return std.fmt.allocPrint(allocator, "{s}/releases/tag/v{s}", .{ zx.info.repository, version }) catch zx.info.repository;
}

fn LiveVersionBadge(allocator: zx.Allocator) zx.Component {
    const release = fetchLatestRelease(allocator);
    const version_raw = if (release) |r| r.version else zx.info.version;
    const version = displayVersion(allocator, version_raw);
    const zig_version = displayVersion(allocator, zx.info.minimum_zig_version);
    const url = if (release) |r| r.url else releasesUrl(allocator) orelse zx.info.repository;
    return (
        <div @{allocator} class="hero-install-meta">
            <a class="hero-install-meta-link" href={url} target="_blank" rel="noopener noreferrer">v{version}</a>
            <span class="hero-install-meta-sep" aria-hidden="true">·</span>
            <span class="hero-install-meta-zig">Zig {zig_version}</span>
        </div>
    );
}

const GhRelease = struct {
    version: []const u8,
    url: []const u8,
};

const GithubRelease = struct {
    tag_name: []const u8,
    html_url: []const u8 = "",
};

fn fetchLatestRelease(allocator: zx.Allocator) ?GhRelease {
    zx.log.debug("Fetching version from GH...", .{});
    const slug = repoSlug() orelse return null;

    const url = std.fmt.allocPrint(
        allocator,
        "https://api.github.com/repos/{s}/releases/latest",
        .{slug},
    ) catch return null;

    const options: zx.http.Client.FetchOptions = .{
        .url = url,
        .headers = &.{
            .{ .name = "Accept", .value = "application/vnd.github+json" },
            .{ .name = "User-Agent", .value = "ziex-site" },
        },
        .timeout_ms = 3_000,
    };

    const response = fetchWithTimeout(allocator, options) orelse return null;
    defer response.deinit(allocator);

    const parsed = response.json(GithubRelease, allocator) catch return null;
    defer parsed.deinit();

    const tag = parsed.value.tag_name;
    if (tag.len == 0) return null;

    const version = if (tag[0] == 'v') tag[1..] else tag;
    const html_url = if (parsed.value.html_url.len > 0)
        parsed.value.html_url
    else
        std.fmt.allocPrint(allocator, "{s}/releases/tag/{s}", .{ zx.info.repository, tag }) catch return null;

    return .{
        .version = allocator.dupe(u8, version) catch return null,
        .url = allocator.dupe(u8, html_url) catch return null,
    };
}

/// The timeout is enforced by the host on wasm and raced against a timer natively.
fn fetchWithTimeout(allocator: zx.Allocator, options: zx.http.Client.FetchOptions) ?zx.http.Client.Result {
    if (comptime zx.platform.isWasm()) return fetchOk(allocator, options);

    const io = zx.Io.default();

    const Branch = union(enum) {
        response: ?zx.http.Client.Result,
        timer: void,
    };

    const FetchTask = struct {
        fn run(a: zx.Allocator, fetch_opts: zx.http.Client.FetchOptions) ?zx.http.Client.Result {
            return fetchOk(a, fetch_opts);
        }
    };

    const Timer = struct {
        fn run(t_io: std.Io, ms: u32) void {
            t_io.sleep(.fromMilliseconds(ms), .awake) catch {};
        }
    };

    var buffer: [2]Branch = undefined;
    var selector = std.Io.Select(Branch).init(io, &buffer);

    selector.async(.response, FetchTask.run, .{ allocator, options });
    selector.async(.timer, Timer.run, .{ io, options.timeout_ms });

    const winner = selector.await() catch {
        zx.log.warn("version fetch timed out or was cancelled", .{});
        return null;
    };
    while (selector.cancel()) |_| {}

    return switch (winner) {
        .response => |r| r,
        .timer => null,
    };
}

fn fetchOk(allocator: zx.Allocator, options: zx.http.Client.FetchOptions) ?zx.http.Client.Result {
    var client: zx.http.Client = .{ .io = zx.Io.default(), .allocator = allocator };
    defer client.deinit();
    const response = client.fetch(options) catch |err| {
        zx.log.warn("version fetch failed: {s}", .{@errorName(err)});
        return null;
    };
    if (response.status.class() != .success) {
        zx.log.warn("version fetch http {d}", .{@backingInt(response.status)});
        response.deinit(allocator);
        return null;
    }
    return response;
}

fn repoSlug() ?[]const u8 {
    const prefix = "https://github.com/";
    const repo = zx.info.repository;
    if (!std.mem.startsWith(u8, repo, prefix)) return null;
    return repo[prefix.len..];
}

fn releasesUrl(allocator: zx.Allocator) ?[]const u8 {
    return std.fmt.allocPrint(allocator, "{s}/releases", .{zx.info.repository}) catch null;
}

// TODO: dedupe the struct for versions.zon
const Versions = struct {
    pub const Release = struct {
        version: []const u8,
        minimum_zig_version: []const u8,
        branch: []const u8,
        status: ReleaseStatus,
    };

    pub const ReleaseStatus = enum {
        current,
        latest,
        development,
        stale,
    };

    releases: []const Release,
};

const versions: Versions = @import("../versions.zon");
const std = @import("std");
const zx = @import("zx");
