pub fn Page(ctx: zx.PageContext) zx.Component {
    const allocator = ctx.arena;
    const slug = ctx.request.params.get("slug") orelse "unknown";
    const page_title = ctx.fmt("Post: {s}", .{slug}) catch "Post";
    ctx.data.set("title", page_title);
    ctx.data.set("description", ctx.fmt("Statically generated post page for slug: {s}", .{slug}) catch "Post page");

    return (
        <div @allocator={allocator}>
            <h1>Post: {slug}</h1>
            <p>This is a statically generated page for slug: {slug}</p>
        </div>
    );
}

pub const options = zx.PageOptions{
    .static = staticParams,
};

fn staticParams(ctx: *zx.StaticContext) !void {
    try ctx.params.add(.{ .slug = "hello-world" });
    try ctx.params.add(.{ .slug = "intro" });
    try ctx.params.add(.{ .slug = "start-1" });
    try ctx.params.add(.{ .slug = "start-2" });
    try ctx.params.add(.{ .slug = "start-3" });
    try ctx.params.add(.{ .slug = "start-4" });

    // Params can also be added dynamically (e.g. from a database or filesystem).
    const dynamic = [_][]const u8{ "dynamic-1", "dynamic-2", "dynamic-3" };
    for (dynamic) |slug| try ctx.params.add(.{ .slug = slug });
}

const std = @import("std");
const zx = @import("zx");
