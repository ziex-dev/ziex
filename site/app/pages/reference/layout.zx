pub fn Layout(ctx: zx.LayoutContext, children: zx.Component) zx.Component {
    return (
        <div @allocator={ctx.arena}>
            <Sidebar allocator={ctx.arena} categories={&categories} toc={toc_links} tabs={&tabs} active_path="/learn" children={children} />
            <script src=`/assets/docs.js?v={zx.info.version}` defer="true"></script>
        </div>
    );
}

const tabs = [_]SidebarProps.Tab{
    .{ .label = "Learn", .href = "/learn", .active = false },
    .{ .label = "Reference", .href = "/reference", .active = true },
};

pub const categories = [_]SidebarProps.Category{
    .{
        .title = "ZX Language",
        .sections = &[_]SidebarProps.Section{
            .{
                .title = "Expressions",
                .href = "/reference#expressions",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/reference#expr-strings", .text = "Strings" },
                    .{ .href = "/reference#expr-integers", .text = "Integers" },
                    .{ .href = "/reference#expr-floats", .text = "Floats" },
                    .{ .href = "/reference#expr-booleans", .text = "Booleans" },
                    .{ .href = "/reference#expr-enums", .text = "Enums" },
                    .{ .href = "/reference#expr-optionals", .text = "Optionals" },
