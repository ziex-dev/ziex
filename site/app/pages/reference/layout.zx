            .{
                .title = "Client Components",
                .href = "/reference#client",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/reference#client-rendering", .text = "Client Rendering" },
                    .{ .href = "/reference#client-state", .text = "Managing State" },
                    .{ .href = "/reference#client-events", .text = "Event Handlers" },
                    .{ .href = "/reference#form-actions", .text = "Form Actions" },
