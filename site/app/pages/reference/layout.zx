                    .{ .href = "/reference#error-capture", .text = "Error Capture" },
                },
            },
            .{
                .title = "Components",
                .href = "/reference#components",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/reference#component-signatures", .text = "Signatures" },
                    .{ .href = "/reference#component-context", .text = "ComponentContext" },
                    .{ .href = "/reference#component-ctx-props", .text = "ComponentCtx" },
                    .{ .href = "/reference#defining-components", .text = "Defining Components" },
                    .{ .href = "/reference#props-coercion", .text = "Props Coercion" },
                },
            },
            .{ .title = "Fragments", .href = "/reference#fragments" },
            .{ .title = "Children Props", .href = "/reference#children-props" },
            .{
                .title = "Attribute Syntax",
