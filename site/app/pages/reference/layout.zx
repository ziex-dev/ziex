            },
            .{
                .title = "API & WebSockets",
                .href = "/reference#api-and-websockets",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/reference#api-routes", .text = "API Routes" },
                    .{ .href = "/reference#route-context", .text = "RouteContext" },
                    .{ .href = "/reference#websockets", .text = "WebSockets" },
