                .items = &[_]SidebarProps.Link{
                    .{ .href = "/reference#spread-attributes", .text = "Spread Attributes" },
                    .{ .href = "/reference#shorthand-attributes", .text = "Shorthand" },
                    .{ .href = "/reference#template-attributes", .text = "Template Strings" },
                },
            },
            .{
                .title = "Builtin Attributes",
                .href = "/reference#builtin-attributes",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/reference#allocator", .text = "@allocator" },
