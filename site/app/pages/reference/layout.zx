    },
    .{
        .title = "Routing & Server",
        .sections = &[_]SidebarProps.Section{
            .{
                .title = "Routing",
                .href = "/reference#routing",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/reference#pages", .text = "Pages" },
                    .{ .href = "/reference#layouts", .text = "Layouts" },
