pub fn Page(ctx: zx.PageContext) !zx.Component {
    if(builtin.optimize == .debug) _ = try main.main();
    return (
        <div @allocator={ctx.arena} class="pg-ide" id="playground-ide">
            <style @escaping={.none}>
                {@embedFile("../../assets/playground.css")}
            </style>

            <TopNavigation />
            <div class="pg-feature-notice is-hidden" id="pg-feature-notice" role="status" aria-live="polite">
                <span class="pg-feature-notice-icon" aria-hidden="true">i</span>
                <p class="pg-feature-notice-text" id="pg-feature-notice-text">Toggle App for client-side rendering. Not all framework features are supported in the playground yet.</p>
                <button class="pg-feature-notice-close" id="pg-feature-notice-close" type="button" aria-label="Dismiss notice" title="Dismiss">Dismiss</button>
            </div>
            <div class="pg-ide-body" id="pg-ide-body">
                <EditorPane />
                <div class="pg-splitter" id="pg-splitter"></div>
                <PreviewPane />
            </div>
            // <StatusBar />
            <script @escaping={.none}>
                {@embedFile("scripts/split.js")}
            </script>
            <script type="module" src=`/assets/playground/editor.js?v={util.buildId(ctx.io, ctx.arena)}`/>
        </div>
    );
}

// ── Top Navigation Component ──
pub fn TopNavigation(ctx: *zx.ComponentCtx(struct {})) zx.Component {
    return (
        <nav @allocator={ctx.allocator}  class="pg-nav">
            <div class="pg-nav-left">
                <a href="/" class="pg-nav-logo">Ziex</a>
                <div class="pg-nav-links">
                    <a href="/learn" class="pg-nav-link">Docs</a>
                    // <a href="/examples" class="pg-nav-link">Examples</a>
                </div>
            </div>
            <ActionButtons @client />
            <div class="pg-nav-actions">
                // <a href="/learn" class="pg-nav-btn">Docs</a>
                <button class="pg-nav-btn pg-nav-btn--primary" id="pg-run-btn" disabled="true" title="Run code (F5)" aria-label="Run code">
                    Run
                    // <span class="pg-run-shortcut">F5</span>
                </button>
                <button class="pg-nav-btn" id="pg-share-btn" title="Share playground" aria-label="Share" disabled="true">
                    <span style="font-family:monospace;font-size:1em;">{"</> "}</span> 
                    <span>
                        <CheckIcon />
                    </span> 
                    Share
                </button>
            </div>
        </nav>
    );
}

// ── Editor Pane Component ──
pub fn EditorPane(ctx: *zx.ComponentCtx(struct {})) zx.Component {
    return (
        <div @allocator={ctx.allocator}  class="pg-editor" id="pg-editor" style="flex: 1 1 55%;">
            <div class="pg-tabs" id="pg-tabs">
                // <button class="pg-tab pg-tab--active" data-file="Playground.zx" id="pg-tab-0">
                //     <span class="pg-tab-icon type-zx"><AllFileIcons /></span>
                //     Playground.zx
                //     <span class="pg-tab-close" aria-label="Close tab" style="opacity: 0.3; pointer-events: none;">×</span>
                // </button>
                // <button class="pg-tab" data-file="style.css" id="pg-tab-2">
                //     <span class="pg-tab-icon type-css"><AllFileIcons /></span>
                //     style.css
                //     <span class="pg-tab-close" aria-label="Close tab">×</span>
                // </button>
                // <button class="pg-tab-add" id="pg-add-file" aria-label="Add new file" title="New file">+</button>
            </div>
            <template id="pg-icons-template">
                <AllFileIcons />
            </template>
            <div class="pg-code" id="pg-code-area">
            </div>
            <EditorStatusBar />
        </div>
    );
}

pub fn EditorStatusBar(ctx: *zx.ComponentCtx(struct {})) zx.Component {
    return (
        <div @allocator={ctx.allocator} class="pg-editor-status" id="pg-editor-status">
            <div class="pg-editor-status-left">
                <span class="pg-editor-status-item" id="pg-cursor-pos">Ln 1, Col 1</span>
                <select id="pg-template-select" class="pg-template-select" aria-label="Select template"></select>
            </div>
            <div class="pg-editor-status-right">
                <button
                    type="button"
                    class="pg-app-toggle"
                    id="pg-app-toggle"
                    aria-pressed="false"
                    title="Toggle App mode (full mini-app with SSR + client hydrate)"
                    aria-label="App mode"
                >
                    App
                </button>
                <button
                    class="pg-editor-status-btn"
                    id="pg-format-btn"
                    type="button"
                    disabled="true"
                    title="Format file (Shift+Alt+F)"
                    aria-label="Format file"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
                        <path d="M3 4.75A.75.75 0 0 1 3.75 4h12.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 4.75ZM3 9.75A.75.75 0 0 1 3.75 9h8.5a.75.75 0 0 1 0 1.5h-8.5A.75.75 0 0 1 3 9.75ZM3 14.75a.75.75 0 0 1 .75-.75h5.5a.75.75 0 0 1 0 1.5h-5.5a.75.75 0 0 1-.75-.75Z"/>
                        <path d="M15.28 9.22a.75.75 0 0 1 1.06 0l2.22 2.22a.75.75 0 1 1-1.06 1.06l-.94-.94V16.5a.75.75 0 0 1-1.5 0v-4.94l-.94.94a.75.75 0 1 1-1.06-1.06l2.22-2.22Z"/>
                    </svg>
                </button>
                <div class="pg-settings" id="pg-settings">
                    <button
                        type="button"
                        class="pg-editor-status-btn"
                        id="pg-settings-btn"
                        title="Playground settings"
                        aria-label="Playground settings"
                        aria-expanded="false"
                        aria-haspopup="true"
                        aria-controls="pg-settings-popover"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
                            <path fill-rule="evenodd" d="M7.84 1.804A1 1 0 0 1 8.82 1h2.36a1 1 0 0 1 .98.804l.331 1.652a6.993 6.993 0 0 1 1.929 1.115l1.598-.54a1 1 0 0 1 1.186.447l1.18 2.044a1 1 0 0 1-.205 1.251l-1.267 1.113a7.047 7.047 0 0 1 0 2.228l1.267 1.113a1 1 0 0 1 .206 1.25l-1.18 2.045a1 1 0 0 1-1.187.447l-1.598-.54a6.993 6.993 0 0 1-1.929 1.115l-.33 1.652a1 1 0 0 1-.98.804H8.82a1 1 0 0 1-.98-.804l-.331-1.652a6.993 6.993 0 0 1-1.929-1.115l-1.598.54a1 1 0 0 1-1.186-.447l-1.18-2.044a1 1 0 0 1 .205-1.251l1.267-1.114a7.05 7.05 0 0 1 0-2.227L1.821 7.773a1 1 0 0 1-.206-1.25l1.18-2.045a1 1 0 0 1 1.187-.447l1.598.54A6.993 6.993 0 0 1 7.51 3.456l.33-1.652ZM10 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" clip-rule="evenodd"/>
                        </svg>
                    </button>
                    <div class="pg-settings-popover is-hidden" id="pg-settings-popover" role="menu">
                        <label class="pg-settings-row" role="menuitemcheckbox" id="pg-persist-files-row">
                            <span>Persist file changes</span>
                            <input type="checkbox" id="pg-persist-files" />
                        </label>
                        <button type="button" class="pg-settings-action" id="pg-reset-template" role="menuitem">Reset template</button>
                        <button type="button" class="pg-settings-action pg-settings-action--danger" id="pg-clear-cache" role="menuitem">Clear cache</button>
                    </div>
                </div>
                <span class="pg-editor-status-item" id="pg-file-lang">ZX</span>
            </div>
        </div>
    );
}

// ── Preview Pane Component ──
pub fn PreviewPane(ctx: *zx.ComponentCtx(struct {})) zx.Component {
    return (
        <div  @allocator={ctx.allocator} class="pg-preview terminal-collapsed" id="pg-preview" style="flex: 1 1 45%;">
            <div class="pg-browser" id="pg-browser">
                <BrowserToolbar />
                <div class="pg-browser-viewport" id="pg-browser-viewport">
                    <div class="pg-browser-placeholder">
                        <div class="pg-browser-placeholder-icon"></div>
                        Press Run to see preview
                    </div>
                </div>
            </div>
            <div class="pg-hsplitter" id="pg-hsplitter"></div>
            <div class="pg-terminal collapsed" id="pg-terminal">
                <div class="pg-terminal-header" id="pg-terminal-header">
                    <div class="pg-terminal-title" role="tablist" aria-label="Panel">
                        <span class="pg-terminal-title-dot"></span>
                        <button type="button" class="pg-panel-tab pg-panel-tab--active" data-panel="output" role="tab" aria-selected="true" id="pg-panel-tab-output">Output</button>
                        <button type="button" class="pg-panel-tab" data-panel="terminal" role="tab" aria-selected="false" id="pg-panel-tab-terminal">Terminal</button>
                    </div>
                    <div class="pg-terminal-actions">
                        <button class="pg-terminal-action-btn" aria-label="Toggle panel" id="pg-terminal-toggle" title="Show/Hide">▲</button>
                        <button class="pg-terminal-action-btn" aria-label="Clear" id="pg-terminal-clear" title="Clear">⌫</button>
                    </div>
                </div>
                <div class="pg-terminal-body" id="pg-terminal-body" role="tabpanel" aria-labelledby="pg-panel-tab-output">
                    <div class="pg-terminal-empty" id="pg-terminal-empty">
                        Build progress & program output will appear here
                    </div>
                </div>
                <div class="pg-shell is-hidden" id="pg-shell" role="tabpanel" aria-labelledby="pg-panel-tab-terminal"></div>
            </div>
        </div>
    );
}

// ── Legacy full-IDE status bar (unused; editor has its own status bar) ──
pub fn StatusBar(ctx: *zx.ComponentCtx(struct {})) zx.Component {
    return (
        <div @allocator={ctx.allocator}  class="pg-status">
            <div class="pg-status-left">
                <span class="pg-status-item">Ziex Playground</span>
                <span class="pg-status-item">Ln 1, Col 1</span>
            </div>
            <div class="pg-status-right">
                <span class="pg-status-item">UTF-8</span>
                <span class="pg-status-item">Zig</span>
            </div>
        </div>
    );
}

pub fn BrowserToolbar(ctx: *zx.ComponentCtx(struct {})) zx.Component {
    return (
        <div @allocator={ctx.allocator} class="pg-browser-toolbar is-hidden" id="pg-browser-toolbar">
            <div class="pg-browser-nav">
                <button class="pg-browser-nav-btn" type="button" aria-label="Back" id="pg-browser-back" disabled="true">◀</button>
                <button class="pg-browser-nav-btn" type="button" aria-label="Forward" id="pg-browser-forward" disabled="true">▶</button>
            </div>
            <form class="pg-browser-url" id="pg-browser-url-form">
                <span class="pg-browser-url-lock" aria-hidden="true"></span>
                <input
                    class="pg-browser-url-text"
                    type="text"
                    value="playground.local/"
                    id="pg-browser-url-input"
                    spellcheck="false"
                    autocomplete="off"
                    aria-label="Preview URL"
                />
            </form>
            <button class="pg-browser-refresh-btn" type="button" aria-label="Refresh" id="pg-browser-refresh">⟳</button>
        </div>
    );
}

pub fn ActionButtons(ctx: *zx.ComponentCtx(struct {})) zx.Component {
    return (
        <div @allocator={ctx.allocator} class="pg-nav-actions" style="display: none;">
            <a href="/learn" class="pg-nav-btn">Docs</a>
            <button onclick={handleRunClick} class="pg-nav-btn pg-nav-btn--primary" id="pg-run-zx-btn">▶ Run</button>
        </div>
    );
}

fn handleRunClick(ctx: zx.client.Event) void {
    _ = ctx;

    if (zx.platform.role != .client) return;

    const document = zx.client.Document.init(zx.allocator);

    const editor_container = document.querySelector(".cm-content") catch unreachable;

    const c = zx.client.Console.init();
    c.log(.{editor_container.ref});
    
    const inner_text: []const u8 = editor_container.ref.getAlloc(zx.client.js.String, zx.allocator, "innerText") catch "NA";
    std.log.info("Run clicked {s}", .{inner_text});
}

const builtin = @import("builtin");
const std = @import("std");
const zx = @import("zx");
const AllFileIcons = @import("../components/icons.zx").AllFileIcons;
const CheckIcon = @import("../components/icons.zx").CheckIcon;
const util = @import("../reference/util.zig");

// Importing to have syntax AST Checked
const main = @import("scripts/template/main.zig");
const Playground = @import("scripts/template/Playground.zx");
