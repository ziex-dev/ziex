#!/usr/bin/env bash
# Sync Zig build plugins from pkg/plugin-* to standalone ziex-dev/plugin-* repos.
#
# Developed in the monorepo; published on release tags so consumers can:
#   zig fetch --save "git+https://github.com/<owner>/plugin-tailwindcss#vX.Y.Z"
#
# Usage:
#   tools/syncplugin <tag> [--owner OWNER] [--dry-run] [--plugin-system-tag TAG] [plugin...]
#
# Examples:
#   tools/syncplugin v0.1.0
#   tools/syncplugin v0.1.0 --dry-run
#   tools/syncplugin v0.1.1 plugin-tailwindcss
#   tools/syncplugin v0.1.1 --plugin-system-tag v0.1.0 plugin-tailwindcss
#
# Environment:
#   GITHUB_TOKEN - optional; falls back to `gh auth token` for push / gh release
#                  (unless --dry-run)
#
# Full syncs publish plugin-system at <tag> first, then rewrite dependents to
# that tag. Filtered syncs of dependents alone reuse an existing plugin-system
# tag (--plugin-system-tag, or the latest GitHub release) and do not republish it.

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

OWNER="${OWNER:-ziex-dev}"
TAG=""
PLUGIN_SYSTEM_TAG=""
DRY_RUN=0
FILTERS=()

PLUGIN_SYSTEM="plugin-system"
# Dependents that path-depend on plugin-system in the monorepo.
DEPENDENT_PLUGINS=(plugin-tailwindcss plugin-typescript plugin-esbuild)
ALL_PLUGINS=("$PLUGIN_SYSTEM" "${DEPENDENT_PLUGINS[@]}")

usage() {
  sed -n '2,24p' "$0" | sed 's/^# \?//'
  exit "${1:-0}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage 0 ;;
    --owner)
      OWNER="${2:?--owner requires a value}"
      shift 2
      ;;
    --plugin-system-tag)
      PLUGIN_SYSTEM_TAG="${2:?--plugin-system-tag requires a value}"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage 1
      ;;
    *)
      if [[ -z "$TAG" ]]; then
        TAG="$1"
      else
        FILTERS+=("$1")
      fi
      shift
      ;;
  esac
done

if [[ -z "$TAG" ]]; then
  echo "error: tag is required (e.g. v0.1.0)" >&2
  usage 1
fi

# Normalize: accept 0.1.0 or v0.1.0
normalize_tag() {
  case "$1" in
    v*) echo "$1" ;;
    *) echo "v$1" ;;
  esac
}
TAG="$(normalize_tag "$TAG")"
if [[ -n "$PLUGIN_SYSTEM_TAG" ]]; then
  PLUGIN_SYSTEM_TAG="$(normalize_tag "$PLUGIN_SYSTEM_TAG")"
fi

if [[ ${#FILTERS[@]} -eq 0 ]]; then
  PLUGINS=("${ALL_PLUGINS[@]}")
  FULL_SYNC=1
else
  PLUGINS=("${FILTERS[@]}")
  FULL_SYNC=0
fi

publish_system=0
has_dependent=0
for p in "${PLUGINS[@]}"; do
  if [[ "$p" == "$PLUGIN_SYSTEM" ]]; then
    publish_system=1
  else
    has_dependent=1
  fi
done

# Full sync always publishes plugin-system first. Explicit filters only publish
# what was named — dependents alone reuse an existing plugin-system tag.
if [[ $FULL_SYNC -eq 1 ]]; then
  publish_system=1
fi

if [[ $publish_system -eq 1 && $has_dependent -eq 1 ]]; then
  ordered=("$PLUGIN_SYSTEM")
  for p in "${PLUGINS[@]}"; do
    [[ "$p" == "$PLUGIN_SYSTEM" ]] && continue
    ordered+=("$p")
  done
  PLUGINS=("${ordered[@]}")
elif [[ $publish_system -eq 1 ]]; then
  PLUGINS=("$PLUGIN_SYSTEM")
fi

if [[ $DRY_RUN -eq 0 && -z "${GITHUB_TOKEN:-}" ]]; then
  if command -v gh >/dev/null 2>&1; then
    GITHUB_TOKEN="$(gh auth token 2>/dev/null || true)"
  fi
  if [[ -z "${GITHUB_TOKEN:-}" ]]; then
    echo "error: set GITHUB_TOKEN or run \`gh auth login\` (unless --dry-run)" >&2
    exit 1
  fi
  export GITHUB_TOKEN
fi

resolve_existing_plugin_system_tag() {
  if [[ -n "$PLUGIN_SYSTEM_TAG" ]]; then
    return 0
  fi
  if [[ $DRY_RUN -eq 1 ]]; then
    PLUGIN_SYSTEM_TAG="v0.0.0-dry-run"
    echo "  [dry-run] no --plugin-system-tag; would resolve latest $OWNER/$PLUGIN_SYSTEM release"
    return 0
  fi
  if ! command -v gh >/dev/null 2>&1; then
    echo "error: gh is required to resolve the latest $PLUGIN_SYSTEM tag (or pass --plugin-system-tag)" >&2
    exit 1
  fi
  PLUGIN_SYSTEM_TAG=$(gh release view --repo "$OWNER/$PLUGIN_SYSTEM" --json tagName -q .tagName)
  if [[ -z "$PLUGIN_SYSTEM_TAG" ]]; then
    echo "error: could not resolve latest $OWNER/$PLUGIN_SYSTEM release; pass --plugin-system-tag" >&2
    exit 1
  fi
  echo "  reusing $PLUGIN_SYSTEM @$PLUGIN_SYSTEM_TAG (pass --plugin-system-tag to override)"
}

copy_plugin_tree() {
  local src="$1"
  local dest="$2"
  mkdir -p "$dest"
  # Prefer rsync when available; fall back to tar to preserve structure.
  if command -v rsync >/dev/null 2>&1; then
    rsync -a \
      --exclude '.zig-cache/' \
      --exclude 'zig-out/' \
      --exclude 'zig-pkg/' \
      --exclude 'node_modules/' \
      --exclude '.git/' \
      --exclude '.DS_Store' \
      "$src"/ "$dest"/
  else
    tar -C "$src" \
      --exclude='.zig-cache' \
      --exclude='zig-out' \
      --exclude='zig-pkg' \
      --exclude='node_modules' \
      --exclude='.git' \
      --exclude='.DS_Store' \
      -cf - . | tar -C "$dest" -xf -
  fi
  if [[ ! -f "$dest/LICENSE" && -f "$ROOT_DIR/LICENSE" ]]; then
    cp "$ROOT_DIR/LICENSE" "$dest/LICENSE"
  fi
}

rewrite_plugin_system_dep() {
  local zon="$1"
  local url="$2"
  local hash="$3"
  if [[ ! -f "$zon" ]]; then
    echo "error: missing $zon" >&2
    exit 1
  fi
  if ! grep -q 'plugin_system' "$zon"; then
    return 0
  fi
  # Replace `.plugin_system = .{ .path = "..." },` (single- or multi-line) with url+hash.
  python3 - "$zon" "$url" "$hash" <<'PY'
import re, sys

path, url, hash_ = sys.argv[1], sys.argv[2], sys.argv[3]
text = open(path, encoding="utf-8").read()
pat = re.compile(
    r'\.plugin_system\s*=\s*\.\{\s*\.path\s*=\s*"[^"]*"\s*,?\s*\},',
    re.S,
)
repl = (
    ".plugin_system = .{\n"
    f'            .url = "{url}",\n'
    f'            .hash = "{hash_}",\n'
    "        },"
)
new, n = pat.subn(repl, text, count=1)
if n != 1:
    sys.stderr.write(
        f"error: failed to rewrite plugin_system path dep in {path} (replacements={n})\n"
    )
    sys.exit(1)
open(path, "w", encoding="utf-8").write(new)
PY
}

ensure_repo() {
  local repo_name="$1"
  local description="$2"
  if [[ $DRY_RUN -eq 1 ]]; then
    echo "  [dry-run] ensure repo $OWNER/$repo_name"
    return 0
  fi
  if gh repo view "$OWNER/$repo_name" >/dev/null 2>&1; then
    return 0
  fi
  echo "  creating $OWNER/$repo_name"
  gh repo create "$OWNER/$repo_name" --public --description "$description" >/dev/null
}

push_plugin_repo() {
  local plugin="$1"
  local tree="$2"
  local repo_name="$plugin"

  ensure_repo "$repo_name" "Ziex Zig build plugin: ${plugin#plugin-}"

  if [[ $DRY_RUN -eq 1 ]]; then
    echo "  [dry-run] would push $plugin -> $OWNER/$repo_name @$TAG"
    echo "  [dry-run] tree preview:"
    find "$tree" -maxdepth 2 -type f | sed 's|^|    |' | head -40
    if [[ -f "$tree/build.zig.zon" ]]; then
      echo "  [dry-run] build.zig.zon:"
      sed 's/^/    /' "$tree/build.zig.zon"
    fi
    return 0
  fi

  local remote_url="https://x-access-token:${GITHUB_TOKEN}@github.com/${OWNER}/${repo_name}.git"
  (
    cd "$tree"
    git init -b main >/dev/null
    git add .
    # Disable signing: ephemeral publish commits use the bot identity (no local key).
    git -c user.name="github-actions[bot]" \
        -c user.email="github-actions[bot]@users.noreply.github.com" \
        -c commit.gpgsign=false \
        commit -m "release: ${TAG} from ${OWNER}/ziex" >/dev/null
    git remote add origin "$remote_url"
    git push -u origin main --force
    # Immutable release tag + moving `latest` pointer for docs / zig fetch defaults.
    git -c tag.gpgsign=false tag "$TAG"
    git -c tag.gpgsign=false tag -f latest
    git push origin "$TAG" --force
    git push origin latest --force
  )

  gh release create "$TAG" \
    --repo "$OWNER/$repo_name" \
    --title "$TAG" \
    --notes "Release ${TAG} - synced from [${OWNER}/ziex@${TAG}](https://github.com/${OWNER}/ziex/releases/tag/${TAG})" \
    2>/dev/null || echo "  note: release $TAG may already exist for $repo_name"
}

fetch_package_hash() {
  local url="$1"
  # zig fetch prints the content hash on stdout.
  zig fetch "$url"
}

PLUGIN_SYSTEM_HASH=""
if [[ $publish_system -eq 1 ]]; then
  PLUGIN_SYSTEM_REF="$TAG"
else
  resolve_existing_plugin_system_tag
  PLUGIN_SYSTEM_REF="$PLUGIN_SYSTEM_TAG"
fi
PLUGIN_SYSTEM_URL="git+https://github.com/${OWNER}/${PLUGIN_SYSTEM}#${PLUGIN_SYSTEM_REF}"

echo "Syncing plugins to $OWNER @ $TAG"
if [[ $publish_system -eq 0 ]]; then
  echo "plugin-system: reuse @$PLUGIN_SYSTEM_REF (not republished)"
fi
[[ $DRY_RUN -eq 1 ]] && echo "(dry-run)"
echo

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

for plugin in "${PLUGINS[@]}"; do
  src="$ROOT_DIR/pkg/$plugin"
  if [[ ! -d "$src" ]]; then
    echo "error: missing package directory $src" >&2
    exit 1
  fi
  if [[ ! -f "$src/build.zig.zon" ]]; then
    echo "error: $src has no build.zig.zon" >&2
    exit 1
  fi

  echo "==> $plugin"
  dest="$WORK/$plugin"
  copy_plugin_tree "$src" "$dest"

  if [[ "$plugin" != "$PLUGIN_SYSTEM" ]]; then
    if [[ -z "$PLUGIN_SYSTEM_HASH" ]]; then
      if [[ $DRY_RUN -eq 1 ]]; then
        PLUGIN_SYSTEM_HASH="DRY_RUN_PLUGIN_SYSTEM_HASH"
        echo "  [dry-run] using placeholder plugin_system hash for $PLUGIN_SYSTEM_URL"
      else
        echo "  fetching plugin_system hash from $PLUGIN_SYSTEM_URL"
        PLUGIN_SYSTEM_HASH=$(fetch_package_hash "$PLUGIN_SYSTEM_URL")
        echo "  plugin_system hash: $PLUGIN_SYSTEM_HASH"
      fi
    fi
    rewrite_plugin_system_dep "$dest/build.zig.zon" "$PLUGIN_SYSTEM_URL" "$PLUGIN_SYSTEM_HASH"
  fi

  push_plugin_repo "$plugin" "$dest"

  if [[ "$plugin" == "$PLUGIN_SYSTEM" && $DRY_RUN -eq 0 ]]; then
    echo "  resolving plugin_system hash after push..."
    PLUGIN_SYSTEM_HASH=$(fetch_package_hash "$PLUGIN_SYSTEM_URL")
    echo "  plugin_system hash: $PLUGIN_SYSTEM_HASH"
  elif [[ "$plugin" == "$PLUGIN_SYSTEM" && $DRY_RUN -eq 1 ]]; then
    PLUGIN_SYSTEM_HASH="DRY_RUN_PLUGIN_SYSTEM_HASH"
  fi

  echo
done

echo "Done."
